            <Style x:Key="MonglePrimaryButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,5,12,7" />
                <Setter Property="Background" Value="{ThemeResource MonglePrimaryButtonBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MonglePrimaryButtonBackgroundBrush}" />
