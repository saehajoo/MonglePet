<UserControl
    x:Class="MonglePet.Windows.PngFrameImportControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}" />
    </UserControl.Resources>
    <Grid ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*" MinWidth="440" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="원본 자르기" />
                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="파란 경계 안을 이동하거나 가장자리·모서리를 끌어 조절합니다." />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="ZoomOutButton" Width="30" Height="24" Padding="0" Click="ZoomOutButton_Click" AutomationProperties.Name="축소">
                        <FontIcon FontSize="12" Glyph="&#xE738;" />
                    </Button>
                    <TextBlock x:Name="ZoomText" MinWidth="40" VerticalAlignment="Center" TextAlignment="Center" Text="1×" />
                    <Button x:Name="ZoomInButton" Width="30" Height="24" Padding="0" Click="ZoomInButton_Click" AutomationProperties.Name="확대">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                    </Button>
                    <Button Height="24" Padding="8,0" Click="FitButton_Click" Content="맞춤" />
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <ScrollViewer
                    x:Name="SourceScrollViewer"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollMode="Disabled"
                    ZoomMode="Disabled">
                    <Canvas
                        x:Name="SourceCanvas"
                        PointerPressed="SourceCanvas_PointerPressed"
                        PointerMoved="SourceCanvas_PointerMoved"
                        PointerReleased="SourceCanvas_PointerReleased"
                        PointerCanceled="SourceCanvas_PointerReleased">
                        <Image x:Name="SourceImage" Stretch="Fill" />
                        <Border x:Name="CropBorder" BorderBrush="#FF1877F2" BorderThickness="2" Background="#101877F2" />
                    </Canvas>
                </ScrollViewer>
            </Border>
            <TextBlock
                Grid.Row="2"
                Style="{StaticResource SettingsCaptionStyle}"
                Text="1×에서는 바깥 화면이 스크롤되며 확대했을 때만 이미지 내부를 양축으로 이동할 수 있습니다." />
        </Grid>

        <Grid Grid.Column="1" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="220" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource SettingsSubcardStyle}" Padding="12">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Width="30" Height="24" Padding="0" Click="PreviousResultButton_Click" AutomationProperties.Name="이전 PNG">
                            <FontIcon FontSize="12" Glyph="&#xE76B;" />
                        </Button>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="1">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="잘라낸 결과" />
                            <TextBlock x:Name="ResultPositionText" HorizontalAlignment="Center" Style="{StaticResource SettingsCaptionStyle}" Text="1 / 1" />
                        </StackPanel>
                        <Button Grid.Column="2" Width="30" Height="24" Padding="0" Click="NextResultButton_Click" AutomationProperties.Name="다음 PNG">
                            <FontIcon FontSize="12" Glyph="&#xE76C;" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="ResultOuterBorder" BorderBrush="#FF1877F2" BorderThickness="2" Background="Transparent">
                            <Canvas x:Name="ResultCanvas">
                                <Image x:Name="ResultImage" Stretch="Fill" />
                            </Canvas>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <InfoBar x:Name="ImportInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Padding="0,0,6,0">
                    <Border Style="{StaticResource SettingsSubcardStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="선택 범위" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox x:Name="CropXNumberBox" Header="X" Minimum="0" ValueChanged="CropNumberBox_ValueChanged" />
                                <NumberBox x:Name="CropYNumberBox" Grid.Column="1" Header="Y" Minimum="0" ValueChanged="CropNumberBox_ValueChanged" />
                                <NumberBox x:Name="CropWidthNumberBox" Grid.Column="2" Header="너비" Minimum="1" ValueChanged="CropNumberBox_ValueChanged" />
                                <NumberBox x:Name="CropHeightNumberBox" Grid.Column="3" Header="높이" Minimum="1" ValueChanged="CropNumberBox_ValueChanged" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Click="FitVisiblePixelsButton_Click" Content="투명 여백 자동 맞춤" />
                                <Button Click="RestoreFullImageButton_Click" Content="원본 전체" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Click="FlipHorizontalButton_Click" Content="좌우 뒤집기" />
                                <Button Click="FlipVerticalButton_Click" Content="상하 뒤집기" />
                            </StackPanel>
                            <Button HorizontalAlignment="Left" Click="ApplyCurrentSizeButton_Click" Content="선택한 PNG에 현재 크기 적용" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="PNG 목록" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Click="SelectAllButton_Click" Content="모두 포함" />
                                    <Button Click="DeselectAllButton_Click" Content="모두 제외" />
                                </StackPanel>
                            </Grid>
                            <ListView
                                x:Name="PngList"
                                MinHeight="220"
                                IsItemClickEnabled="True"
                                ItemClick="PngList_ItemClick"
                                SelectionMode="Multiple"
                                SelectionChanged="PngList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinWidth="280" Padding="4" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="가져오기에 포함"
                                                IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                Checked="PngIncludedCheckBox_Changed"
                                                Unchecked="PngIncludedCheckBox_Changed" />
                                            <Border Grid.Column="1" Width="44" Height="44" BorderBrush="#FF1877F2" BorderThickness="{Binding FocusBorderThickness}" CornerRadius="6">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="3"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="PNG 목록에서 제거"
                                                Click="RemovePngButton_Click">
                                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button HorizontalAlignment="Left" Click="AddMorePngButton_Click" Content="PNG 더 추가…" />
                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="체크한 PNG만 추가됩니다. Ctrl 키를 누른 채 행을 클릭하면 여러 PNG를 일괄 편집할 수 있습니다." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
