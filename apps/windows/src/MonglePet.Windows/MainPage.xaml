<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MonglePet.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MonglePet.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsSubcardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="26" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
        <Style x:Key="SettingsHeroStyle" TargetType="Border">
            <Setter Property="Padding" Value="22,20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
        <Style x:Key="SettingsDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style x:Key="SettingsCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="ApplicationPickerItemTemplate">
            <Grid Padding="4,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <FontIcon FontSize="22" Glyph="&#xE8A5;" />
                    <Image Source="{Binding Icon}" Stretch="Uniform" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding DisplayName}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding Identifier}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <NavigationView
        x:Name="SettingsNavigationView"
        Background="Transparent"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Top"
        SelectionChanged="SettingsNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="펫" IsSelected="True" Tag="pet">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="일반" Tag="general">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="이동" Tag="movement">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Map" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="행동 루틴" Tag="routines">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="말풍선" Tag="speech">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Comment" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="자동 규칙" Tag="automaticRules">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="32,12,32,48">
                <StackPanel
                    MaxWidth="960"
                    HorizontalAlignment="Stretch"
                    Spacing="20">

            <Border Style="{StaticResource SettingsHeroStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="48"
                        Height="48"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="24">
                        <Image Margin="9" Source="Assets/AppIcon.ico" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="SettingsSectionTitle" Style="{StaticResource TitleTextBlockStyle}" Text="펫" />
                        <TextBlock
                            x:Name="SettingsSectionDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="현재 펫을 선택하고 .monglepet 패키지를 가져오거나 내보냅니다."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                x:Name="OverlayInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="공통 샘플 패키지를 읽고 Composition 이미지 표면을 준비하는 중입니다."
                Severity="Informational"
                Title="펫 오버레이 실험" />

            <Border
                x:Name="GeneralSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="펫 표시" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="몽글이를 깨우거나 잠시 재울 수 있습니다. 재워도 시스템 트레이에서 언제든 다시 깨울 수 있습니다." />
                    </StackPanel>
                    <Button
                        x:Name="VisibilityButton"
                        Click="VisibilityButton_Click"
                        Content="펫 재우기"
                        HorizontalAlignment="Left" />
                    <Border Style="{StaticResource SettingsDividerStyle}" />
                    <StackPanel x:Name="BehaviorOverviewPanel" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="행동 모드" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="자동 모드에서는 사용 중인 앱과 입력 없음 시간을 살피고, 수동 모드에서는 선택한 행동 루틴을 반복합니다." />
                        </StackPanel>
                        <ComboBox
                            x:Name="BehaviorModeComboBox"
                            Header="행동 모드"
                            SelectionChanged="BehaviorModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="자동" Tag="Automatic" />
                            <ComboBoxItem Content="수동" Tag="Manual" />
                        </ComboBox>
                        <ComboBox
                            x:Name="ManualSequenceComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="수동 행동 루틴"
                            SelectedValuePath="Id"
                            SelectionChanged="ManualSequenceComboBox_SelectionChanged" />
                        <TextBlock
                            x:Name="BehaviorDescriptionText"
                            Style="{StaticResource SettingsCaptionStyle}" />
                        <Expander Header="행동 상태 진단">
                            <StackPanel Spacing="4">
                                <TextBlock x:Name="BehaviorStatusText" Style="{StaticResource SettingsCaptionStyle}" />
                                <TextBlock x:Name="ActivityStatusText" Style="{StaticResource SettingsCaptionStyle}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="OverlaySettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="화면 표시" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="펫의 크기와 선명도, 화면 위에서 마우스와 겹칠 때의 표시 방법을 정합니다." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="ClickThroughToggle"
                        Header="클릭 통과"
                        IsOn="True"
                        Toggled="ClickThroughToggle_Toggled" />
                    <ToggleSwitch
                        x:Name="PointerOverlapFadeToggle"
                        Header="마우스가 펫과 겹치면 흐리게"
                        Toggled="PointerOverlapFadeToggle_Toggled" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="펫 크기" />
                        <Slider
                            x:Name="OverlayWidthSlider"
                            Grid.Column="1"
                            Maximum="384"
                            Minimum="96"
                            SmallChange="8"
                            StepFrequency="8"
                            ValueChanged="DisplaySlider_ValueChanged" />
                        <TextBlock
                            x:Name="OverlayWidthValueText"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="투명도" />
                        <Slider
                            x:Name="OverlayOpacitySlider"
                            Grid.Row="1"
                            Grid.Column="1"
                            Maximum="1"
                            Minimum="0.1"
                            SmallChange="0.05"
                            StepFrequency="0.05"
                            ValueChanged="DisplaySlider_ValueChanged" />
                        <TextBlock
                            x:Name="OverlayOpacityValueText"
                            Grid.Row="1"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="겹침 투명도" />
                        <Slider
                            x:Name="PointerOverlapOpacitySlider"
                            Grid.Row="2"
                            Grid.Column="1"
                            Maximum="1"
                            Minimum="0.05"
                            SmallChange="0.05"
                            StepFrequency="0.05"
                            ValueChanged="DisplaySlider_ValueChanged" />
                        <TextBlock
                            x:Name="PointerOverlapOpacityValueText"
                            Grid.Row="2"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="클릭 통과가 켜진 동안 마우스가 펫의 보이는 부분에 닿았을 때만 겹침 투명도를 적용합니다." />
                    <ToggleSwitch
                        x:Name="PixelArtToggle"
                        Header="픽셀 아트 선명하게"
                        Toggled="PixelArtToggle_Toggled" />
                    <TextBlock
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="픽셀 아트는 nearest 보간으로 또렷하게 표시합니다. 일반 일러스트에서는 끄는 편이 자연스럽습니다."
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsDividerStyle}" />
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="앱 실행" />
                        <ToggleSwitch
                            x:Name="LoginLaunchToggle"
                            Header="로그인 시 MonglePet 자동 실행"
                            Toggled="LoginLaunchToggle_Toggled" />
                        <TextBlock
                            x:Name="LoginLaunchStatusText"
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="Windows 시작 앱 상태를 확인하는 중입니다." />
                        <Button
                            x:Name="OpenStartupAppsSettingsButton"
                            Click="OpenStartupAppsSettingsButton_Click"
                            Content="Windows 시작 앱 설정 열기"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsDividerStyle}" />
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="앱 정보" />
                        <TextBlock x:Name="AppVersionText" Text="MonglePet 버전을 확인하는 중입니다." />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="Windows 11에서 동작하는 네이티브 데스크톱 펫입니다. 설정과 활동 정보는 이 기기 안에 저장됩니다." />
                    </StackPanel>
                    <Expander Header="진단 정보">
                        <TextBlock x:Name="OverlayStatusText" Style="{StaticResource SettingsCaptionStyle}" />
                    </Expander>
                    <InfoBar
                        x:Name="DisplaySettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <Border
                x:Name="SpeechSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="말풍선" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="현재 펫이 행동을 바꾸거나 일정 시간이 지났을 때 보여 줄 말을 정합니다." />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="설정 대상 펫" />
                            <TextBlock
                                x:Name="SpeechTargetPetText"
                                Grid.Column="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                    </Border>
                    <ToggleSwitch
                        x:Name="SpeechEnabledToggle"
                        Header="말풍선 사용"
                        Toggled="SpeechSettings_Changed" />
                    <ComboBox
                        x:Name="SpeechBehaviorChangePolicyComboBox"
                        Header="행동이 바뀌었는데 연결된 대사가 없을 때"
                        SelectionChanged="SpeechSettings_Changed">
                        <ComboBoxItem Content="현재 말풍선 닫기" Tag="Dismiss" />
                        <ComboBoxItem Content="다음 대사까지 유지" Tag="Keep" />
                    </ComboBox>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="주기적으로 말하기" />
                            <ToggleSwitch
                                x:Name="SpeechPeriodicEnabledToggle"
                                Header="주기 대사 사용"
                                Toggled="SpeechSettings_Changed" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="SpeechPeriodicIntervalNumberBox"
                                    Header="표시 간격 (초)"
                                    Maximum="3600"
                                    Minimum="5"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="SpeechSettings_Changed" />
                                <ComboBox
                                    x:Name="SpeechPeriodicOrderComboBox"
                                    Grid.Column="1"
                                    Header="재생 순서"
                                    SelectionChanged="SpeechSettings_Changed">
                                    <ComboBoxItem Content="무작위" Tag="Random" />
                                    <ComboBoxItem Content="순차" Tag="Sequential" />
                                </ComboBox>
                            </Grid>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="시간 지정 대사는 말풍선이 숨은 뒤부터 기다리고, 유지 대사는 표시된 시점부터 기다린 뒤 다음 대사로 교체합니다." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="행동 대사" />
                            <ListView
                                x:Name="BehaviorSpeechPhrasesList"
                                SelectionChanged="BehaviorSpeechPhrasesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddBehaviorSpeechPhraseButton" Click="AddBehaviorSpeechPhraseButton_Click" Content="행동 대사 추가…" />
                                <Button x:Name="EditBehaviorSpeechPhraseButton" Click="EditBehaviorSpeechPhraseButton_Click" Content="수정…" />
                                <Button x:Name="DeleteBehaviorSpeechPhraseButton" Click="DeleteBehaviorSpeechPhraseButton_Click" Content="삭제" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="행동 루틴이 시작될 때 우선해서 보여 줄 대사입니다." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="주기 대사" />
                            <ListView
                                x:Name="PeriodicSpeechPhrasesList"
                                SelectionChanged="PeriodicSpeechPhrasesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddPeriodicSpeechPhraseButton" Click="AddPeriodicSpeechPhraseButton_Click" Content="주기 대사 추가…" />
                                <Button x:Name="EditPeriodicSpeechPhraseButton" Click="EditPeriodicSpeechPhraseButton_Click" Content="수정…" />
                                <Button x:Name="DeletePeriodicSpeechPhraseButton" Click="DeletePeriodicSpeechPhraseButton_Click" Content="삭제" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="행동 대사가 없을 때 설정한 간격과 순서로 보여 줄 대사입니다." />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="SpeechPhraseEditorPanel"
                        Style="{StaticResource SettingsSubcardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SpeechPhraseEditorTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="대사 편집" />
                            <TextBox
                                x:Name="SpeechPhraseTextBox"
                                Header="대사"
                                MaxLength="120"
                                PlaceholderText="펫이 표시할 짧은 문장을 입력하세요."
                                TextChanged="SpeechPhraseTextBox_TextChanged"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SpeechTriggerComboBox"
                                    Header="표시 조건"
                                    Visibility="Collapsed"
                                    SelectionChanged="SpeechPhraseForm_Changed">
                                    <ComboBoxItem Content="주기 대사" Tag="Periodic" />
                                    <ComboBoxItem Content="행동 루틴 진입" Tag="Sequence" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="SpeechSequenceComboBox"
                                    Grid.Column="1"
                                    DisplayMemberPath="DisplayName"
                                    Header="행동 루틴"
                                    SelectedValuePath="Id" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SpeechDisplayModeComboBox"
                                    Header="표시 방식"
                                    SelectionChanged="SpeechPhraseForm_Changed">
                                    <ComboBoxItem Content="지정 시간 뒤 닫기" Tag="Timed" />
                                    <ComboBoxItem Content="다음 대사까지 유지" Tag="UntilNextPhrase" />
                                </ComboBox>
                                <NumberBox
                                    x:Name="SpeechDisplayDurationNumberBox"
                                    Grid.Column="1"
                                    Header="표시 시간 (초)"
                                    Maximum="30"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveSpeechPhraseButton" Click="SaveSpeechPhraseButton_Click" Content="대사 저장" />
                                <Button x:Name="CancelSpeechPhraseButton" Click="CancelSpeechPhraseButton_Click" Content="취소" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="모양과 미리보기" />
                            <ComboBox
                                x:Name="SpeechThemeStyleComboBox"
                                Header="색상 테마"
                                SelectionChanged="SpeechSettings_Changed">
                                <ComboBoxItem Content="시스템" Tag="System" />
                                <ComboBoxItem Content="크림" Tag="Cream" />
                                <ComboBoxItem Content="밤" Tag="Midnight" />
                                <ComboBoxItem Content="민트" Tag="Mint" />
                                <ComboBoxItem Content="복숭아" Tag="Peach" />
                                <ComboBoxItem Content="사용자 지정" Tag="Custom" />
                            </ComboBox>
                            <Grid x:Name="SpeechCustomColorsGrid" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="배경 색상" />
                                    <ColorPicker
                                        x:Name="SpeechBackgroundColorPicker"
                                        ColorChanged="SpeechSettings_Changed"
                                        IsAlphaEnabled="False" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="글자 색상" />
                                    <ColorPicker
                                        x:Name="SpeechTextColorPicker"
                                        ColorChanged="SpeechSettings_Changed"
                                        IsAlphaEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox
                                    x:Name="SpeechBackgroundOpacityNumberBox"
                                    Header="배경 불투명도 (%)"
                                    Maximum="100"
                                    Minimum="65"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechFontSizeNumberBox"
                                    Grid.Column="1"
                                    Header="글자 크기"
                                    Maximum="24"
                                    Minimum="11"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
