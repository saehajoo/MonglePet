                            <TextBlock x:Name="SpeechPhraseEditorTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="대사 편집" />
                            <TextBox
                                x:Name="SpeechPhraseTextBox"
                                Header="대사"
                                MaxLength="120"
                                PlaceholderText="펫이 표시할 짧은 문장을 입력하세요."
                                TextChanged="SpeechPhraseTextBox_TextChanged"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SpeechTriggerComboBox"
                                    Header="표시 조건"
                                    Visibility="Collapsed"
                                    SelectionChanged="SpeechPhraseForm_Changed">
                                    <ComboBoxItem Content="주기 대사" Tag="Periodic" />
                                    <ComboBoxItem Content="행동 루틴 진입" Tag="Sequence" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="SpeechSequenceComboBox"
                                    Grid.Column="1"
                                    DisplayMemberPath="DisplayName"
                                    Header="행동 루틴"
                                    SelectedValuePath="Id" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SpeechDisplayModeComboBox"
                                    Header="표시 방식"
                                    SelectionChanged="SpeechPhraseForm_Changed">
                                    <ComboBoxItem Content="지정 시간 뒤 닫기" Tag="Timed" />
                                    <ComboBoxItem Content="다음 대사까지 유지" Tag="UntilNextPhrase" />
                                </ComboBox>
                                <NumberBox
                                    x:Name="SpeechDisplayDurationNumberBox"
                                    Grid.Column="1"
                                    Header="표시 시간 (초)"
                                    Maximum="30"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveSpeechPhraseButton" Click="SaveSpeechPhraseButton_Click" Content="대사 저장" />
                                <Button x:Name="CancelSpeechPhraseButton" Click="CancelSpeechPhraseButton_Click" Content="취소" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="모양과 미리보기" />
                            <ComboBox
                                x:Name="SpeechThemeStyleComboBox"
                                Header="색상 테마"
                                SelectionChanged="SpeechSettings_Changed">
                                <ComboBoxItem Content="시스템" Tag="System" />
                                <ComboBoxItem Content="크림" Tag="Cream" />
                                <ComboBoxItem Content="밤" Tag="Midnight" />
                                <ComboBoxItem Content="민트" Tag="Mint" />
                                <ComboBoxItem Content="복숭아" Tag="Peach" />
                                <ComboBoxItem Content="사용자 지정" Tag="Custom" />
                            </ComboBox>
                            <Grid x:Name="SpeechCustomColorsGrid" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="배경 색상" />
                                    <ColorPicker
                                        x:Name="SpeechBackgroundColorPicker"
                                        ColorChanged="SpeechSettings_Changed"
                                        IsAlphaEnabled="False" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="글자 색상" />
                                    <ColorPicker
                                        x:Name="SpeechTextColorPicker"
                                        ColorChanged="SpeechSettings_Changed"
                                        IsAlphaEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox
                                    x:Name="SpeechBackgroundOpacityNumberBox"
                                    Header="배경 불투명도 (%)"
                                    Maximum="100"
                                    Minimum="65"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechFontSizeNumberBox"
                                    Grid.Column="1"
                                    Header="글자 크기"
                                    Maximum="24"
                                    Minimum="11"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechPaddingNumberBox"
                                    Grid.Row="1"
                                    Header="안쪽 여백"
                                    Maximum="24"
                                    Minimum="6"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechCornerRadiusNumberBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Header="모서리 반경"
                                    Maximum="28"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    x:Name="SpeechTailToggle"
                                    Header="말풍선 꼬리 표시"
                                    Toggled="SpeechSettings_Changed" />
                                <ComboBox
                                    x:Name="SpeechTailAlignmentComboBox"
                                    Grid.Column="1"
                                    Header="꼬리 정렬"
                                    SelectionChanged="SpeechSettings_Changed">
                                    <ComboBoxItem Content="왼쪽" Tag="Leading" />
                                    <ComboBoxItem Content="가운데" Tag="Center" />
                                    <ComboBoxItem Content="오른쪽" Tag="Trailing" />
                                </ComboBox>
                            </Grid>
                            <Border
                                Padding="20"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <Grid x:Name="SpeechPlacementPreviewGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="104" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        x:Name="SpeechThemePreviewBorder"
                                        MaxWidth="360"
                                        Padding="12"
                                        HorizontalAlignment="Center"
                                        CornerRadius="14">
                                        <TextBlock
                                            x:Name="SpeechThemePreviewText"
                                            Text="오늘도 같이 있어요!"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Polygon
                                        x:Name="SpeechThemePreviewTail"
                                        Grid.Row="1"
                                        Width="18"
                                        Height="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Points="0,0 18,0 9,10" />
                                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                                        <FontIcon
                                            x:Name="SpeechPetPreviewPlaceholder"
                                            FontSize="44"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xEB55;" />
                                        <Image
                                            x:Name="SpeechPetPreviewImage"
                                            Width="104"
                                            Height="104"
                                            Stretch="Uniform" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="위치" />
                            <ComboBox
                                x:Name="SpeechPreferredPositionComboBox"
                                Header="선호 위치"
                                SelectionChanged="SpeechSettings_Changed">
                                <ComboBoxItem Content="자동" Tag="Automatic" />
                                <ComboBoxItem Content="펫 위" Tag="Above" />
                                <ComboBoxItem Content="펫 아래" Tag="Below" />
                            </ComboBox>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="SpeechHorizontalOffsetNumberBox"
                                    Header="좌우 오프셋"
                                    Maximum="160"
                                    Minimum="-160"
                                    SmallChange="4"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechGapNumberBox"
                                    Grid.Column="1"
                                    Header="펫 사이 간격"
                                    Maximum="64"
                                    Minimum="0"
                                    SmallChange="2"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button
                        x:Name="SaveSpeechSettingsButton"
                        Click="SaveSpeechSettingsButton_Click"
                        Content="말풍선 설정 저장"
                        HorizontalAlignment="Left" />
                    <InfoBar
                        x:Name="SpeechSettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <Border
                x:Name="MovementSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="이동" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="현재 펫이 데스크톱에서 움직이는 방식과 사용할 애니메이션을 정합니다." />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="설정 대상 펫" />
                            <TextBlock x:Name="MovementTargetPetText" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="이동 방식" />
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <RadioButton
                            x:Name="FixedMovementModeRadio"
                            GroupName="MovementMode"
                            Tag="0"
                            Checked="MovementModeRadioButton_Checked">
                            <Border MinWidth="280" Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="위치 고정" />
                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="원하는 자리에 머물며 직접 드래그해 옮깁니다." />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <RadioButton
                            x:Name="FreeRoamingMovementModeRadio"
                            Grid.Column="1"
                            GroupName="MovementMode"
                            Tag="2"
                            Checked="MovementModeRadioButton_Checked">
                            <Border MinWidth="280" Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="자유 이동" />
                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="화면 안을 천천히 돌아다니며 잠시 머뭅니다." />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <RadioButton
                            x:Name="CursorFollowingMovementModeRadio"
                            Grid.Row="1"
                            GroupName="MovementMode"
                            Tag="1"
                            Checked="MovementModeRadioButton_Checked">
                            <Border MinWidth="280" Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="마우스 따라가기" />
                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="마우스 포인터를 일정 거리를 두고 따라갑니다." />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <RadioButton
                            x:Name="CursorAvoidingMovementModeRadio"
                            Grid.Row="1"
                            Grid.Column="1"
                            GroupName="MovementMode"
                            Tag="3"
                            Checked="MovementModeRadioButton_Checked">
                            <Border MinWidth="280" Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="마우스 도망가기" />
                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="마우스가 가까이 오면 반대 방향으로 달아납니다." />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                    </Grid>
                    <ComboBox
                        x:Name="MovementModeComboBox"
                        Header="이동 모드"
                        Visibility="Collapsed"
                        SelectionChanged="MovementControls_Changed">
                        <ComboBoxItem Content="위치 고정" Tag="Fixed" />
                        <ComboBoxItem Content="마우스 따라가기" Tag="CursorFollowing" />
                        <ComboBoxItem Content="자유 이동" Tag="FreeRoaming" />
                        <ComboBoxItem Content="마우스 도망가기" Tag="CursorAvoiding" />
                    </ComboBox>
                    <StackPanel x:Name="FixedMovementHelpPanel" Spacing="4">
                        <TextBlock
                            x:Name="FixedMovementHelpText"
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="펫을 직접 드래그한 위치에 그대로 둡니다." />
                    </StackPanel>
                    <StackPanel x:Name="MovementSensePanel" Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="이동 감각" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="MovementSpeedNumberBox"
                                Header="이동 속도 (px/s)"
                                Maximum="1000"
                                Minimum="20"
                                SmallChange="10"
                                ValueChanged="MovementControls_Changed" />
                            <NumberBox
                                x:Name="MovementStopRadiusNumberBox"
                                Grid.Column="1"
                                Header="정지 반경 (px)"
                                Maximum="128"
                                Minimum="0"
                                SmallChange="4"
                                ValueChanged="MovementControls_Changed" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="MovementBoundaryPanel" Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="이동 범위" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="MovementBoundaryModeComboBox"
                                Header="이동 범위"
                                SelectionChanged="MovementControls_Changed">
                                <ComboBoxItem Content="모든 화면" Tag="AllDisplays" />
                                <ComboBoxItem Content="선택 모니터" Tag="SelectedDisplay" />
                                <ComboBoxItem Content="사용자 지정" Tag="CustomArea" />
                            </ComboBox>
                            <ComboBox
                                x:Name="MovementScreenComboBox"
                                Grid.Column="1"
                                DisplayMemberPath="DisplayName"
                                Header="대상 모니터"
                                SelectedValuePath="Identifier"
                                SelectionChanged="MovementControls_Changed" />
                        </Grid>
                        <Grid x:Name="MovementCustomAreaPanel" ColumnSpacing="12" RowSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <NumberBox x:Name="MovementAreaXNumberBox" Header="왼쪽 여백 (%)" Minimum="0" Maximum="99" SmallChange="5" ValueChanged="MovementControls_Changed" />
                            <NumberBox x:Name="MovementAreaYNumberBox" Grid.Column="1" Header="아래쪽 여백 (%)" Minimum="0" Maximum="99" SmallChange="5" ValueChanged="MovementControls_Changed" />
                            <NumberBox x:Name="MovementAreaWidthNumberBox" Grid.Row="1" Header="영역 너비 (%)" Minimum="1" Maximum="100" SmallChange="5" ValueChanged="MovementControls_Changed" />
                            <NumberBox x:Name="MovementAreaHeightNumberBox" Grid.Row="1" Grid.Column="1" Header="영역 높이 (%)" Minimum="1" Maximum="100" SmallChange="5" ValueChanged="MovementControls_Changed" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="CursorFollowingOptionsPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="마우스 따라가기" />
                        <NumberBox
                            x:Name="CursorDistanceNumberBox"
                            Header="마우스와 거리 (px)"
                            Maximum="512"
                            Minimum="0"
                            SmallChange="8"
                            ValueChanged="MovementControls_Changed" />
                        <local:MovementAnimationEditor x:Name="CursorFollowingAnimationEditor" SettingsChanged="MovementAnimationEditor_SettingsChanged" />
                        <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="마우스 포인터와 지정한 거리를 유지하며 화면 안에서 따라갑니다." />
                    </StackPanel>
                    <StackPanel x:Name="FreeRoamingOptionsPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock x:Name="FreeRoamingSectionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="자유 이동" />
                        <NumberBox
                            x:Name="FreeRoamingDwellNumberBox"
                            Header="머무는 시간 (초)"
                            Maximum="300"
                            Minimum="0.5"
                            SmallChange="0.5"
                            ValueChanged="MovementControls_Changed" />
                        <ToggleSwitch
                            x:Name="RandomizesDwellToggle"
                            Header="머무는 시간을 범위 안에서 무작위로 선택"
                            Toggled="MovementControls_Changed" />
                        <NumberBox
                            x:Name="FreeRoamingDwellMinimumNumberBox"
                            Header="최소 머무는 시간 (초)"
                            Maximum="300"
                            Minimum="0.5"
                            SmallChange="0.5"
                            ValueChanged="MovementControls_Changed" />
                        <ToggleSwitch
                            x:Name="PrefersFrontmostWindowToggle"
                            Header="현재 사용 중인 앱의 창 근처를 우선"
                            Toggled="MovementControls_Changed" />
                        <local:MovementAnimationEditor x:Name="FreeRoamingAnimationEditor" SettingsChanged="MovementAnimationEditor_SettingsChanged" />
                        <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="창 정보를 얻을 수 없거나 전체 화면이면 현재 화면 안에서 안전한 위치를 선택합니다." />
                    </StackPanel>
                    <StackPanel x:Name="CursorAvoidingOptionsPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="마우스 도망가기" />
                        <ComboBox
                            x:Name="AvoidingIdleBehaviorComboBox"
                            Header="평상시 행동"
                            SelectionChanged="MovementControls_Changed">
                            <ComboBoxItem Content="가만히 있기" Tag="Stationary" />
                            <ComboBoxItem Content="자유 이동" Tag="FreeRoaming" />
                        </ComboBox>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="AvoidingDetectionNumberBox"
                                Header="마우스 감지 거리 (px)"
                                Maximum="1024"
                                Minimum="32"
                                SmallChange="8"
                                ValueChanged="MovementControls_Changed" />
                            <NumberBox
                                x:Name="AvoidingSpeedNumberBox"
                                Grid.Column="1"
                                Header="도망가는 속도 (px/s)"
                                Maximum="1000"
                                Minimum="20"
                                SmallChange="10"
                                ValueChanged="MovementControls_Changed" />
                        </Grid>
                        <local:MovementAnimationEditor x:Name="CursorAvoidingAnimationEditor" SettingsChanged="MovementAnimationEditor_SettingsChanged" />
                        <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="안전한 거리까지 멀어지면 선택한 평상시 행동으로 돌아갑니다." />
                    </StackPanel>
                    <StackPanel x:Name="MovementInteractionPanel" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="상호작용" />
                        <ComboBox
                            x:Name="PettingMotionComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="쓰다듬기 행동"
                            SelectedValuePath="Id"
                            SelectionChanged="MovementControls_Changed" />
                        <TextBlock x:Name="PettingDescriptionText" Style="{StaticResource SettingsCaptionStyle}" />
                    </StackPanel>
                    <InfoBar
                        x:Name="MovementSettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <Border
                x:Name="PetLibraryCard"
                Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="현재 펫" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="지금 데스크톱에서 함께하고 있는 펫과 사용할 수 있는 애니메이션입니다." />
                    </StackPanel>
                    <ComboBox
                        x:Name="CurrentPetComboBox"
                        DisplayMemberPath="DisplayName"
                        Header="현재 펫"
                        SelectedValuePath="InstallationId"
                        SelectionChanged="CurrentPetComboBox_SelectionChanged" />
                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="160"
                                Height="160"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <Grid>
                                    <FontIcon
                                        x:Name="CurrentPetPreviewPlaceholder"
                                        FontSize="52"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xEB55;" />
                                    <Image
                                        x:Name="CurrentPetPreviewImage"
                                        Margin="8"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock
                                    x:Name="CurrentPetNameText"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="펫을 불러오는 중입니다." />
                                <TextBlock x:Name="CurrentPetAuthorVersionText" Style="{StaticResource SettingsCaptionStyle}" />
                                <TextBlock x:Name="CurrentPetDescriptionText" TextWrapping="Wrap" />
                                <TextBlock x:Name="CurrentPetMotionText" Style="{StaticResource SettingsCaptionStyle}" />
