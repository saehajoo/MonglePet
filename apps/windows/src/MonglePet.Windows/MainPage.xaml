                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="ChooseApplicationButton"
                                        Click="ChooseApplicationButton_Click"
                                        Content="실행 중 앱 선택…" />
                                    <Button
                                        x:Name="ChooseExecutableButton"
                                        Click="ChooseExecutableButton_Click"
                                        Content="실행 파일 선택…" />
                                    <Button
                                        x:Name="UseCurrentApplicationButton"
                                        Click="UseCurrentApplicationButton_Click"
                                        Content="현재 전면 앱 사용" />
                                </StackPanel>
                            </StackPanel>
                            <NumberBox
                                x:Name="RuleIdleMinutesNumberBox"
                                Header="입력 없음 시간 (초)"
                                Maximum="86400"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="1"
                                Visibility="Collapsed" />
                            <ComboBox
                                x:Name="RuleTargetSequenceComboBox"
                                DisplayMemberPath="DisplayName"
                                Header="실행할 루틴"
                                SelectedValuePath="Id" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddRuleButton" Click="AddRuleButton_Click" Content="앱 규칙 추가" />
                                <Button
                                    x:Name="SaveRuleButton"
                                    Click="SaveRuleButton_Click"
                                    Content="선택 규칙 저장" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="입력 없음 감지는 1초 주기라 실제 전환에 최대 약 1초가 걸릴 수 있습니다." />
                        </StackPanel>
                    </Border>
                    <InfoBar
                        x:Name="BehaviorSettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Page>
