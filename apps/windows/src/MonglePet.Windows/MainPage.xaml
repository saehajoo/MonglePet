                                Grid.Column="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                    </Border>
                    <Border
                        x:Name="RoutineEditorCard"
                        Style="{StaticResource SettingsSubcardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="편집할 행동 루틴" />
                            <ComboBox
                                x:Name="RoutineEditorComboBox"
                                DisplayMemberPath="DisplayName"
                                Header="편집할 루틴"
                                SelectedValuePath="Id"
                                SelectionChanged="RoutineEditorComboBox_SelectionChanged" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewSequenceNameTextBox" Header="새 행동 루틴 만들기" PlaceholderText="루틴 이름" />
                                <Button
                                    x:Name="AddSequenceButton"
                                    Grid.Column="1"
                                    Margin="0,24,0,0"
                                    Click="AddSequenceButton_Click"
                                    Content="만들기" />
                                <Button
                                    x:Name="DeleteSequenceButton"
                                    Grid.Column="2"
                                    Margin="0,24,0,0"
                                    Click="DeleteSequenceButton_Click"
                                    Content="선택 삭제" />
                            </Grid>
                            <ToggleSwitch
                                x:Name="SequenceRepeatsToggle"
                                Header="마지막 단계 후 처음부터 반복"
                                Toggled="SequenceRepeatsToggle_Toggled" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="애니메이션 단계" />
                            <ListView
                                x:Name="BehaviorStepsList"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="124" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    VerticalAlignment="Bottom"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    CornerRadius="16">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding DisplayIndex}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="애니메이션" />
                                                    <ComboBox
                                                        MinWidth="220"
                                                        HorizontalAlignment="Stretch"
                                                        ItemsSource="{Binding MotionOptions}"
                                                        DisplayMemberPath="DisplayName"
                                                        SelectedValue="{Binding MotionId, Mode=OneWay}"
                                                        SelectedValuePath="Id"
                                                        SelectionChanged="StepMotionComboBox_SelectionChanged"
                                                        Tag="{Binding Index}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="5">
                                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="반복 횟수" />
                                                    <NumberBox
                                                        Maximum="100000"
                                                        Minimum="1"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Compact"
                                                        Tag="{Binding Index}"
                                                        Value="{Binding RepeatCount, Mode=OneWay}"
                                                        ValueChanged="StepRepeatCountNumberBox_ValueChanged" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="3"
                                                    VerticalAlignment="Bottom"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <Button
                                                        Width="36"
                                                        Click="MoveStepUpButton_Click"
                                                        Content="↑"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        Tag="{Binding Index}"
                                                        ToolTipService.ToolTip="위로 이동" />
                                                    <Button
                                                        Width="36"
                                                        Click="MoveStepDownButton_Click"
                                                        Content="↓"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Tag="{Binding Index}"
                                                        ToolTipService.ToolTip="아래로 이동" />
                                                    <Button
                                                        Click="RemoveStepButton_Click"
                                                        Content="삭제"
                                                        IsEnabled="{Binding CanDelete}"
                                                        Tag="{Binding Index}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="AddStepButton" Click="AddStepButton_Click" Content="애니메이션 단계 추가" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="현재 펫이 가진 애니메이션을 순서대로 조합합니다. 루틴 이름은 생성 후에는 바꿀 수 없습니다." />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AutomaticRulesCard"
                        Style="{StaticResource SettingsSubcardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="등록된 규칙" />
                            <ListView
                                x:Name="AutomaticRulesList"
                                SelectionChanged="AutomaticRulesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Summary}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="NewApplicationRuleButton" Click="NewApplicationRuleButton_Click" Content="앱 규칙 추가" />
                                <Button x:Name="NewIdleRuleButton" Click="NewIdleRuleButton_Click" Content="입력 없음 규칙 추가" />
                                <Button x:Name="DeleteRuleButton" Click="DeleteRuleButton_Click" Content="선택 규칙 삭제" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RuleEnabledToggle" Header="규칙 사용" IsOn="True" />
                            <NumberBox
                                x:Name="RulePriorityNumberBox"
                                Header="우선순위 (큰 숫자 먼저)"
                                Maximum="2147483647"
                                Minimum="-2147483648"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact" />
                            <ComboBox
                                x:Name="RuleConditionTypeComboBox"
                                Header="조건 종류"
                                SelectionChanged="RuleConditionTypeComboBox_SelectionChanged">
                                <ComboBoxItem Content="전면 앱" Tag="Application" />
                                <ComboBoxItem Content="입력 없음" Tag="Idle" />
                            </ComboBox>
                            <StackPanel x:Name="ApplicationRuleEditorGrid" Spacing="8">
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="선택한 대상 앱" />
                                        <TextBlock
                                            x:Name="RuleApplicationSelectionText"
                                            Text="선택되지 않음"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBox
                                    x:Name="RuleApplicationIdTextBox"
                                    Header="Windows 앱 식별자"
                                    PlaceholderText="pfn:... 또는 exe:notepad.exe"
                                    TextChanged="RuleApplicationIdTextBox_TextChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="ChooseApplicationButton"
                                        Click="ChooseApplicationButton_Click"
                                        Content="실행 중 앱 선택…" />
                                    <Button
                                        x:Name="ChooseExecutableButton"
                                        Click="ChooseExecutableButton_Click"
                                        Content="실행 파일 선택…" />
                                    <Button
                                        x:Name="UseCurrentApplicationButton"
                                        Click="UseCurrentApplicationButton_Click"
                                        Content="현재 전면 앱 사용" />
                                </StackPanel>
                            </StackPanel>
                            <NumberBox
                                x:Name="RuleIdleMinutesNumberBox"
                                Header="입력 없음 시간 (분)"
                                Maximum="1440"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="1" />
                            <ComboBox
                                x:Name="RuleTargetSequenceComboBox"
                                DisplayMemberPath="DisplayName"
                                Header="실행할 루틴"
                                SelectedValuePath="Id" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddRuleButton" Click="AddRuleButton_Click" Content="새 규칙 추가" />
                                <Button
                                    x:Name="SaveRuleButton"
                                    Click="SaveRuleButton_Click"
                                    Content="선택 규칙 저장" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="숫자가 큰 우선순위부터 검사하며, 조건을 만족하는 첫 번째 규칙을 사용합니다." />
                        </StackPanel>
                    </Border>
                    <InfoBar
                        x:Name="BehaviorSettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Page>
