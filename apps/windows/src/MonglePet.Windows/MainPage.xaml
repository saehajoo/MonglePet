                                <Button x:Name="EditPeriodicSpeechPhraseButton" Click="EditPeriodicSpeechPhraseButton_Click" Content="수정…" />
                                <Button x:Name="DeletePeriodicSpeechPhraseButton" Click="DeletePeriodicSpeechPhraseButton_Click" Content="삭제" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
