<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MonglePet.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MonglePet.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SettingsHeroStyle" TargetType="Border">
            <Setter Property="Padding" Value="4,8,4,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SettingsDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <DataTemplate x:Key="ApplicationPickerItemTemplate">
            <Grid Padding="4,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <FontIcon FontSize="22" Glyph="&#xE8A5;" />
                    <Image Source="{Binding Icon}" Stretch="Uniform" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding DisplayName}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding Identifier}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <NavigationView
        x:Name="SettingsNavigationView"
        AlwaysShowHeader="False"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        CompactPaneLength="52"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsSettingsVisible="False"
        OpenPaneLength="220"
        PaneDisplayMode="Left"
        SelectionChanged="SettingsNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="데스크톱" />
            <NavigationViewItem Content="내 펫" IsSelected="True" Tag="activePets">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="일반" Tag="general">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="선택한 펫" />
            <NavigationViewItem Content="펫 정보·애니메이션" Tag="pet">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="화면 표시" Tag="display">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Map" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="평상시 행동" Tag="stationary">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="이동" Tag="movement">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Map" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="상호작용" Tag="interaction">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Edit" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="행동 편집" Tag="routines">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="말풍선" Tag="speech">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Comment" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="규칙 설정" Tag="automaticRules">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="지원" />
            <NavigationViewItem Content="문제 해결" Tag="troubleshooting">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,12,28,48">
                <StackPanel
                    MaxWidth="920"
                    HorizontalAlignment="Stretch"
                    Spacing="20">

            <Border Style="{StaticResource SettingsHeroStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="48"
                        Height="48"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                        <Image Margin="9" Source="Assets/AppIcon.ico" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="SettingsSectionTitle" Style="{StaticResource TitleTextBlockStyle}" Text="펫" />
                        <TextBlock
                            x:Name="SettingsSectionDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="현재 펫을 선택하고 .monglepet 패키지를 가져오거나 내보냅니다."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                x:Name="SafeStartInfoBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Title="안전 시작">
                <InfoBar.ActionButton>
                    <Button Click="ResumeAllSafeStartButton_Click" Content="모두 복원" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border
                x:Name="TroubleshootingCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="안전 모드" />
                    <TextBlock
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="이전 실행에서 펫 복원이 중단되었을 때만 안전 시작이 활성화됩니다. 문제가 된 마지막 펫을 제외하거나 모든 펫을 다시 복원할 수 있습니다."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ResumeAllSafeStartButton_Click" Content="모두 복원" />
                        <Button
                            x:Name="ResumeWithoutLastSafeStartButton"
                            Click="ResumeWithoutLastSafeStartButton_Click"
                            Content="마지막 복원 펫 제외"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="ActivePetsCard"
                Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="각 펫은 독립된 이미지, 행동, 이동과 말풍선 설정을 사용합니다. 잠시 숨기려면 삭제하지 말고 재워 주세요." />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            AutomationProperties.Name="펫 만들기"
                            Click="CreatePetButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Viewbox Width="14" Height="14">
                                    <SymbolIcon Symbol="Add" />
                                </Viewbox>
                                <TextBlock Text="펫 만들기" />
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="펫 가져오기" Click="ImportPetFromDashboardButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Viewbox Width="14" Height="14">
                                    <SymbolIcon Symbol="Download" />
                                </Viewbox>
                                <TextBlock Text="펫 가져오기" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border
                        Margin="0,4,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="전체 펫 제어" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button AutomationProperties.Name="모두 깨우기" Click="WakeAllPetsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Viewbox Width="14" Height="14">
                                            <SymbolIcon Symbol="Play" />
                                        </Viewbox>
                                        <TextBlock Text="모두 깨우기" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="모두 재우기" Click="TuckAwayAllPetsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Viewbox Width="14" Height="14">
                                            <SymbolIcon Symbol="Stop" />
                                        </Viewbox>
                                        <TextBlock Text="모두 재우기" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="모든 펫 일시정지 또는 계속" Click="PauseAllPetsButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <Viewbox Width="14" Height="14">
                                            <SymbolIcon x:Name="PauseAllPetsIcon" Symbol="Pause" />
                                        </Viewbox>
                                        <TextBlock x:Name="PauseAllPetsText" Text="모두 일시정지" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListView
                        x:Name="ActivePetsList"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        IsItemClickEnabled="False"
                        SelectionChanged="ActivePetsList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsTabStop" Value="True" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="UseSystemFocusVisuals" Value="True" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border Padding="16" CornerRadius="16" Style="{StaticResource SettingsSubcardStyle}">
                                        <Grid ColumnSpacing="16" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Grid.RowSpan="5"
                                                Width="84"
                                                Height="84"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                CornerRadius="12">
                                                <Grid>
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="28"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="🐾" />
                                                    <Image Margin="6" Source="{Binding Preview}" Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource MongleControlAccentBrush}"
                                                    Text="설정 중"
                                                    Visibility="{Binding SelectionVisibility}" />
                                            </StackPanel>
                                            <Grid
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    VerticalAlignment="Center"
                                                    LineHeight="20"
                                                    LineStackingStrategy="BlockLineHeight"
                                                    Style="{StaticResource SettingsCaptionStyle}"
                                                    Text="{Binding StatusTitle}" />
                                                <ToggleSwitch
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="펫 화면 표시"
                                                    Height="34"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    IsOn="{Binding IsAwake, Mode=OneWay}"
                                                    MinHeight="34"
                                                    MinWidth="44"
                                                    OffContent="{x:Null}"
                                                    OnContent="{x:Null}"
                                                    Tag="{Binding InstanceId}"
                                                    ToolTipService.ToolTip="펫 깨우기 또는 재우기"
                                                    Width="44"
                                                    Toggled="ActivePetAwakeToggle_Toggled">
                                                    <ToggleSwitch.Resources>
                                                        <ResourceDictionary>
                                                            <ResourceDictionary.ThemeDictionaries>
                                                                <ResourceDictionary x:Key="Default">
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFC6C6C6" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFDADADA" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFB0B0B0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#FF777777" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FFC6C6C6" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FFDADADA" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FFB0B0B0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#FF777777" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF303030" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF303030" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF303030" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FFB0B0B0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF303030" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF3A3A3A" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FF252525" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#FF404040" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF858585" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FFA0A0A0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#FF707070" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#FF606060" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFC6C6C6" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFDADADA" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FFB0B0B0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#FF8A8A8A" />
                                                                </ResourceDictionary>
                                                                <ResourceDictionary x:Key="Light">
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF666666" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF505050" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF3E3E3E" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#FFAAAAAA" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF666666" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF505050" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF3E3E3E" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled" Color="#FFAAAAAA" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFF7F7F7" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFF0F0F0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#FFF0F0F0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FFE4E4E4" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FFF0F0F0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOffPressed" Color="#FFD0D0D0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchFillOffDisabled" Color="#FFF0F0F0" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF8A8A8A" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#FF707070" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="#FF5F5F5F" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchStrokeOffDisabled" Color="#FFC8C8C8" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF666666" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FF505050" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPressed" Color="#FF3E3E3E" />
                                                                    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffDisabled" Color="#FF999999" />
                                                                </ResourceDictionary>
                                                            </ResourceDictionary.ThemeDictionaries>
                                                        </ResourceDictionary>
                                                    </ToggleSwitch.Resources>
                                                </ToggleSwitch>
                                            </Grid>
                                            <TextBlock
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Style="{StaticResource SettingsCaptionStyle}"
                                                Text="{Binding OriginalNameText}"
                                                Visibility="{Binding OriginalNameVisibility}" />
                                            <StackPanel
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="16">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding MovementStatus}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding InteractionStatus}" />
                                            </StackPanel>
                                            <Grid Grid.Row="3" Grid.Column="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    PlaceholderText="구분 이름 (선택)"
                                                    Tag="{Binding InstanceId}"
                                                    Text="{Binding Nickname, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Stretch"
                                                    Click="SaveActivePetNicknameButton_Click"
                                                    Content="저장"
                                                    IsEnabled="{Binding CanSaveNickname}"
                                                    Tag="{Binding InstanceId}" />
                                            </Grid>
                                            <StackPanel
                                                Grid.Row="3"
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="2">
                                                <Button
                                                    AutomationProperties.Name="한 단계 앞으로"
                                                    Click="MoveActivePetUpButton_Click"
                                                    IsEnabled="{Binding CanMoveUp}"
                                                    Style="{StaticResource ActivePetIconButtonStyle}"
                                                    Tag="{Binding InstanceId}"
                                                    ToolTipService.ToolTip="한 단계 앞으로">
                                                    <TextBlock FontSize="15" Text="↑" />
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="한 단계 뒤로"
                                                    Click="MoveActivePetDownButton_Click"
                                                    IsEnabled="{Binding CanMoveDown}"
                                                    Style="{StaticResource ActivePetIconButtonStyle}"
                                                    Tag="{Binding InstanceId}"
                                                    ToolTipService.ToolTip="한 단계 뒤로">
                                                    <TextBlock FontSize="15" Text="↓" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="4"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button AutomationProperties.Name="펫 사본 만들기" Click="DuplicateActivePetButton_Click" Tag="{Binding InstanceId}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Viewbox Width="14" Height="14">
                                                            <SymbolIcon Symbol="Copy" />
                                                        </Viewbox>
                                                        <TextBlock Text="펫 사본 만들기" />
                                                    </StackPanel>
                                                </Button>
                                                <Button
                                                    AutomationProperties.Name="패키지로 내보내기"
                                                    Click="ExportActivePetButton_Click"
                                                    Tag="{Binding InstanceId}"
                                                    Visibility="{Binding ExportVisibility}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Viewbox Width="14" Height="14">
                                                            <SymbolIcon Symbol="Upload" />
                                                        </Viewbox>
                                                        <TextBlock Text="패키지로 내보내기" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <Button
                                                Grid.Row="4"
                                                Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="펫과 모든 설정 완전히 삭제"
                                                Click="RemoveActivePetButton_Click"
                                                Foreground="{ThemeResource MongleDangerForegroundBrush}"
                                                IsEnabled="{Binding CanRemove}"
                                                Style="{StaticResource ActivePetIconButtonStyle}"
                                                Tag="{Binding InstanceId}"
                                                ToolTipService.ToolTip="펫과 모든 설정 완전히 삭제">
                                                <Viewbox Width="15" Height="15">
                                                    <SymbolIcon Symbol="Delete" />
                                                </Viewbox>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <Border
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="16"
                                        IsHitTestVisible="False"
                                        Opacity="0.09"
                                        Visibility="{Binding SelectionVisibility}" />
                                    <Border
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="16"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding SelectionVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border
                x:Name="GeneralSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="PetPresentationPanel" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="표시 상태" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="선택한 펫을 깨우거나 잠시 재울 수 있습니다. 재워도 시스템 트레이나 활성 펫 화면에서 다시 깨울 수 있습니다." />
                        </StackPanel>
                        <Button
                            x:Name="VisibilityButton"
                            Click="VisibilityButton_Click"
                            Content="펫 재우기"
                            HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="OverlaySettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="OverlayDisplayPanel" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="화면 표시" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="펫의 크기와 선명도, 화면 위에서 마우스와 겹칠 때의 표시 방법을 정합니다." />
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="펫 크기" />
                                <Slider
                                    x:Name="OverlayWidthSlider"
                                    Grid.Column="1"
                                    Maximum="384"
                                    Minimum="19.2"
                                    SmallChange="9.6"
                                    StepFrequency="9.6"
                                    ValueChanged="DisplaySlider_ValueChanged" />
                                <TextBlock
                                    x:Name="OverlayWidthValueText"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SettingsCaptionStyle}" Text="빠른 크기" />
                                <Button Click="OverlaySizePresetButton_Click" Content="10%" Tag="10" />
                                <Button Click="OverlaySizePresetButton_Click" Content="25%" Tag="25" />
                                <Button Click="OverlaySizePresetButton_Click" Content="50%" Tag="50" />
                                <Button Click="OverlaySizePresetButton_Click" Content="100%" Tag="100" />
                                <Button Click="OverlaySizePresetButton_Click" Content="150%" Tag="150" />
                                <Button Click="OverlaySizePresetButton_Click" Content="200%" Tag="200" />
                            </StackPanel>
                            <InfoBar
                                x:Name="TinyPetInfoBar"
                                IsClosable="False"
                                IsOpen="False"
                                Message="아주 작은 펫은 찾거나 드래그하기 어려울 수 있습니다. 설정에서 다시 크게 만들거나 ‘현재 화면으로 가져오기’를 사용하세요."
                                Severity="Warning"
                                Title="아주 작은 펫 크기">
                                <InfoBar.ActionButton>
                                    <Button Click="BringPetToCurrentScreenButton_Click" Content="현재 화면으로 가져오기" />
                                </InfoBar.ActionButton>
                            </InfoBar>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="100%는 192px이며 10%~200% 범위에서 펫마다 따로 저장됩니다." />
                        </StackPanel>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="기본 투명도" />
                            <Slider
                                x:Name="OverlayOpacitySlider"
                                Grid.Column="1"
                                Maximum="1"
                                Minimum="0.1"
                                SmallChange="0.05"
                                StepFrequency="0.05"
                                ValueChanged="DisplaySlider_ValueChanged" />
                            <TextBlock
                                x:Name="OverlayOpacityValueText"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                        </Grid>
                        <ToggleSwitch
                            x:Name="PixelArtToggle"
                            Header="픽셀 아트 선명하게"
                            Toggled="PixelArtToggle_Toggled" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="픽셀 아트의 확대 경계를 또렷하게 표시합니다. 일반 일러스트에서는 계단 현상이 보일 수 있습니다."
                            TextWrapping="Wrap" />
                        <Border Style="{StaticResource SettingsDividerStyle}" />
                        <ToggleSwitch
                            x:Name="ClickThroughToggle"
                            Header="클릭 통과"
                            IsOn="True"
                            Toggled="ClickThroughToggle_Toggled" />
                        <TextBlock
                            x:Name="ClickThroughDescriptionText"
                            Style="{StaticResource SettingsCaptionStyle}"
                            TextWrapping="Wrap" />
                        <Border Style="{StaticResource SettingsDividerStyle}" />
                        <ToggleSwitch
                            x:Name="PointerOverlapFadeToggle"
                            Header="마우스가 펫과 겹치면 더 투명하게"
                            Toggled="PointerOverlapFadeToggle_Toggled" />
                        <StackPanel x:Name="PointerOverlapOpacityPanel" Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="겹침 투명도" />
                                <Slider
                                    x:Name="PointerOverlapOpacitySlider"
                                    Grid.Column="1"
                                    Maximum="1"
                                    Minimum="0.05"
                                    SmallChange="0.05"
                                    StepFrequency="0.05"
                                    ValueChanged="DisplaySlider_ValueChanged" />
                                <TextBlock
                                    x:Name="PointerOverlapOpacityValueText"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="마우스가 펫의 보이는 부분과 겹칠 때 적용할 투명도입니다."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="DisplayApplicationDivider" Style="{StaticResource SettingsDividerStyle}" />
                    <StackPanel x:Name="ApplicationSettingsPanel" Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="앱 실행" />
                        <ToggleSwitch
                            x:Name="LoginLaunchToggle"
                            Header="로그인 시 MonglePet 자동 실행"
                            Toggled="LoginLaunchToggle_Toggled" />
                        <TextBlock
                            x:Name="LoginLaunchStatusText"
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="Windows 시작 앱 상태를 확인하는 중입니다." />
                        <Button
                            x:Name="OpenStartupAppsSettingsButton"
                            Click="OpenStartupAppsSettingsButton_Click"
                            Content="Windows 시작 앱 설정 열기"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Border x:Name="ApplicationInfoDivider" Style="{StaticResource SettingsDividerStyle}" />
                    <StackPanel x:Name="AppInformationPanel" Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="앱 정보" />
                            <TextBlock x:Name="AppVersionText" Text="MonglePet 버전을 확인하는 중입니다." />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="Windows 11에서 동작하는 네이티브 데스크톱 펫입니다. 설정과 활동 정보는 이 기기 안에 저장됩니다." />
                        </StackPanel>
                    </StackPanel>
                    <InfoBar
                        x:Name="DisplaySettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <Border
                x:Name="SpeechSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="말풍선" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="현재 펫이 행동을 바꾸거나 일정 시간이 지났을 때 보여 줄 말을 정합니다." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="SpeechEnabledToggle"
                        Header="말풍선 사용"
                        Toggled="SpeechSettings_Changed" />
                    <ComboBox
                        x:Name="SpeechBehaviorChangePolicyComboBox"
                        Header="행동이 바뀌었는데 연결된 대사가 없을 때"
                        SelectionChanged="SpeechSettings_Changed">
                        <ComboBoxItem Content="현재 말풍선 닫기" Tag="Dismiss" />
                        <ComboBoxItem Content="다음 대사까지 유지" Tag="Keep" />
                    </ComboBox>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="주기적으로 말하기" />
                            <ToggleSwitch
                                x:Name="SpeechPeriodicEnabledToggle"
                                Header="주기 대사 사용"
                                Toggled="SpeechSettings_Changed" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="SpeechPeriodicIntervalNumberBox"
                                    Header="표시 간격 (초)"
                                    Maximum="3600"
                                    Minimum="5"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="SpeechSettings_Changed" />
                                <ComboBox
                                    x:Name="SpeechPeriodicOrderComboBox"
                                    Grid.Column="1"
                                    Header="재생 순서"
                                    SelectionChanged="SpeechSettings_Changed">
                                    <ComboBoxItem Content="무작위" Tag="Random" />
                                    <ComboBoxItem Content="순차" Tag="Sequential" />
                                </ComboBox>
                            </Grid>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="시간 지정 대사는 말풍선이 숨은 뒤부터 기다리고, 유지 대사는 표시된 시점부터 기다린 뒤 다음 대사로 교체합니다." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="행동 대사" />
                            <ListView
                                x:Name="BehaviorSpeechPhrasesList"
                                SelectionChanged="BehaviorSpeechPhrasesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddBehaviorSpeechPhraseButton" Click="AddBehaviorSpeechPhraseButton_Click" Content="행동 대사 추가…" />
                                <Button x:Name="EditBehaviorSpeechPhraseButton" Click="EditBehaviorSpeechPhraseButton_Click" Content="수정…" />
                                <Button x:Name="DeleteBehaviorSpeechPhraseButton" Click="DeleteBehaviorSpeechPhraseButton_Click" Content="삭제" Foreground="{ThemeResource MongleDangerForegroundBrush}" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="행동 루틴이 시작될 때 우선해서 보여 줄 대사입니다." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="주기 대사" />
                            <ListView
                                x:Name="PeriodicSpeechPhrasesList"
                                SelectionChanged="PeriodicSpeechPhrasesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddPeriodicSpeechPhraseButton" Click="AddPeriodicSpeechPhraseButton_Click" Content="주기 대사 추가…" />
                                <Button x:Name="EditPeriodicSpeechPhraseButton" Click="EditPeriodicSpeechPhraseButton_Click" Content="수정…" />
                                <Button x:Name="DeletePeriodicSpeechPhraseButton" Click="DeletePeriodicSpeechPhraseButton_Click" Content="삭제" Foreground="{ThemeResource MongleDangerForegroundBrush}" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="행동 대사가 없을 때 설정한 간격과 순서로 보여 줄 대사입니다." />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="SpeechPhraseEditorPanel"
                        Style="{StaticResource SettingsSubcardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock x:Name="SpeechPhraseEditorTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="대사 편집" />
                            <TextBox
                                x:Name="SpeechPhraseTextBox"
                                Header="대사"
                                MaxLength="120"
                                PlaceholderText="펫이 표시할 짧은 문장을 입력하세요."
                                TextChanged="SpeechPhraseTextBox_TextChanged"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SpeechTriggerComboBox"
                                    Header="표시 조건"
                                    Visibility="Collapsed"
                                    SelectionChanged="SpeechPhraseForm_Changed">
                                    <ComboBoxItem Content="주기 대사" Tag="Periodic" />
                                    <ComboBoxItem Content="행동 루틴 진입" Tag="Sequence" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="SpeechSequenceComboBox"
                                    Grid.Column="1"
                                    DisplayMemberPath="DisplayName"
                                    Header="행동 루틴"
                                    SelectedValuePath="Id" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="SpeechDisplayModeComboBox"
                                    Header="표시 방식"
                                    SelectionChanged="SpeechPhraseForm_Changed">
                                    <ComboBoxItem Content="지정 시간 뒤 닫기" Tag="Timed" />
                                    <ComboBoxItem Content="다음 대사까지 유지" Tag="UntilNextPhrase" />
                                </ComboBox>
                                <NumberBox
                                    x:Name="SpeechDisplayDurationNumberBox"
                                    Grid.Column="1"
                                    Header="표시 시간 (초)"
                                    Maximum="30"
                                    Minimum="1"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveSpeechPhraseButton" Click="SaveSpeechPhraseButton_Click" Content="대사 저장" />
                                <Button x:Name="CancelSpeechPhraseButton" Click="CancelSpeechPhraseButton_Click" Content="취소" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="모양과 미리보기" />
                            <ComboBox
                                x:Name="SpeechThemeStyleComboBox"
                                Header="색상 테마"
                                SelectionChanged="SpeechSettings_Changed">
                                <ComboBoxItem Content="시스템" Tag="System" />
                                <ComboBoxItem Content="크림" Tag="Cream" />
                                <ComboBoxItem Content="밤" Tag="Midnight" />
                                <ComboBoxItem Content="민트" Tag="Mint" />
                                <ComboBoxItem Content="복숭아" Tag="Peach" />
                                <ComboBoxItem Content="사용자 지정" Tag="Custom" />
                            </ComboBox>
                            <Grid x:Name="SpeechCustomColorsGrid" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="배경 색상" />
                                    <ColorPicker
                                        x:Name="SpeechBackgroundColorPicker"
                                        ColorChanged="SpeechSettings_Changed"
                                        IsAlphaEnabled="False" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="글자 색상" />
                                    <ColorPicker
                                        x:Name="SpeechTextColorPicker"
                                        ColorChanged="SpeechSettings_Changed"
                                        IsAlphaEnabled="False" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <NumberBox
                                    x:Name="SpeechBackgroundOpacityNumberBox"
                                    Header="배경 불투명도 (%)"
                                    Maximum="100"
                                    Minimum="65"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechFontSizeNumberBox"
                                    Grid.Column="1"
                                    Header="글자 크기"
                                    Maximum="24"
                                    Minimum="11"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechPaddingNumberBox"
                                    Grid.Row="1"
                                    Header="안쪽 여백"
                                    Maximum="24"
                                    Minimum="6"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechCornerRadiusNumberBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Header="모서리 반경"
                                    Maximum="28"
                                    Minimum="0"
                                    SmallChange="1"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ToggleSwitch
                                    x:Name="SpeechTailToggle"
                                    Header="말풍선 꼬리 표시"
                                    Toggled="SpeechSettings_Changed" />
                                <ComboBox
                                    x:Name="SpeechTailAlignmentComboBox"
                                    Grid.Column="1"
                                    Header="꼬리 정렬"
                                    SelectionChanged="SpeechSettings_Changed">
                                    <ComboBoxItem Content="왼쪽" Tag="Leading" />
                                    <ComboBoxItem Content="가운데" Tag="Center" />
                                    <ComboBoxItem Content="오른쪽" Tag="Trailing" />
                                </ComboBox>
                            </Grid>
                            <Border
                                Padding="20"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <Grid x:Name="SpeechPlacementPreviewGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="104" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border
                                        x:Name="SpeechThemePreviewBorder"
                                        MaxWidth="360"
                                        Padding="12"
                                        HorizontalAlignment="Center"
                                        CornerRadius="14">
                                        <TextBlock
                                            x:Name="SpeechThemePreviewText"
                                            Text="오늘도 같이 있어요!"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Polygon
                                        x:Name="SpeechThemePreviewTail"
                                        Grid.Row="1"
                                        Width="18"
                                        Height="10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Points="0,0 18,0 9,10" />
                                    <Grid Grid.Row="2" HorizontalAlignment="Center">
                                        <FontIcon
                                            x:Name="SpeechPetPreviewPlaceholder"
                                            FontSize="44"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Glyph="&#xEB55;" />
                                        <Image
                                            x:Name="SpeechPetPreviewImage"
                                            Width="104"
                                            Height="104"
                                            Stretch="Uniform" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="위치" />
                            <ComboBox
                                x:Name="SpeechPreferredPositionComboBox"
                                Header="선호 위치"
                                SelectionChanged="SpeechSettings_Changed">
                                <ComboBoxItem Content="자동" Tag="Automatic" />
                                <ComboBoxItem Content="펫 위" Tag="Above" />
                                <ComboBoxItem Content="펫 아래" Tag="Below" />
                            </ComboBox>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="SpeechHorizontalOffsetNumberBox"
                                    Header="좌우 오프셋"
                                    Maximum="160"
                                    Minimum="-160"
                                    SmallChange="4"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                                <NumberBox
                                    x:Name="SpeechGapNumberBox"
                                    Grid.Column="1"
                                    Header="펫 사이 간격"
                                    Maximum="64"
                                    Minimum="0"
                                    SmallChange="2"
                                    SpinButtonPlacementMode="Compact"
                                    ValueChanged="SpeechSettings_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button
                        x:Name="SaveSpeechSettingsButton"
                        Click="SaveSpeechSettingsButton_Click"
                        Content="말풍선 설정 저장"
                        HorizontalAlignment="Left" />
                    <InfoBar
                        x:Name="SpeechSettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <Border
                x:Name="BehaviorOverviewPanel"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="평상시 행동" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="이동하지 않고 조건 규칙이 일치하지 않을 때 표시할 행동을 정합니다." />
                    </StackPanel>
                    <ComboBox
                        x:Name="BehaviorModeComboBox"
                        Header="선택 방식"
                        SelectionChanged="BehaviorModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="하나 선택" Tag="Fixed" />
                        <ComboBoxItem Content="랜덤 선택" Tag="Random" />
                    </ComboBox>
                    <ComboBox
                        x:Name="ManualSequenceComboBox"
                        DisplayMemberPath="DisplayName"
                        Header="평상시에 표시할 행동"
                        SelectedValuePath="Id"
                        SelectionChanged="ManualSequenceComboBox_SelectionChanged" />
                    <ListView
                        x:Name="RandomSequencesList"
                        DisplayMemberPath="DisplayName"
                        Header="랜덤으로 재생할 행동"
                        MaxHeight="220"
                        SelectionChanged="RandomSequencesList_SelectionChanged"
                        SelectionMode="Multiple" />
                    <TextBlock
                        x:Name="BehaviorDescriptionText"
                        Style="{StaticResource SettingsCaptionStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                x:Name="MovementSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <InfoBar
                        x:Name="MovementSettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                    <TextBlock x:Name="MovementModeTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" Text="이동 방식" />
                    <Grid x:Name="MovementModeChoicesGrid" ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <RadioButton
                            x:Name="FixedMovementModeRadio"
                            GroupName="MovementMode"
                            Tag="0"
                            Checked="MovementModeRadioButton_Checked">
                            <Border MinWidth="280" Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="위치 고정" />
                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="원하는 자리에 머물며 직접 드래그해 옮깁니다." />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <RadioButton
                            x:Name="FreeRoamingMovementModeRadio"
                            Grid.Column="1"
                            GroupName="MovementMode"
                            Tag="2"
                            Checked="MovementModeRadioButton_Checked">
                            <Border MinWidth="280" Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="자유 이동" />
                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="화면 안을 천천히 돌아다니며 잠시 머뭅니다." />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <RadioButton
                            x:Name="CursorFollowingMovementModeRadio"
                            Grid.Row="1"
                            GroupName="MovementMode"
                            Tag="1"
                            Checked="MovementModeRadioButton_Checked">
                            <Border MinWidth="280" Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="마우스 따라가기" />
                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="마우스 포인터를 일정 거리를 두고 따라갑니다." />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <RadioButton
                            x:Name="CursorAvoidingMovementModeRadio"
                            Grid.Row="1"
                            Grid.Column="1"
                            GroupName="MovementMode"
                            Tag="3"
                            Checked="MovementModeRadioButton_Checked">
                            <Border MinWidth="280" Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="마우스 도망가기" />
                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="마우스가 가까이 오면 반대 방향으로 달아납니다." />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                    </Grid>
                    <ComboBox
                        x:Name="MovementModeComboBox"
                        Header="이동 모드"
                        Visibility="Collapsed"
                        SelectionChanged="MovementControls_Changed">
                        <ComboBoxItem Content="위치 고정" Tag="Fixed" />
                        <ComboBoxItem Content="마우스 따라가기" Tag="CursorFollowing" />
                        <ComboBoxItem Content="자유 이동" Tag="FreeRoaming" />
                        <ComboBoxItem Content="마우스 도망가기" Tag="CursorAvoiding" />
                    </ComboBox>
                    <StackPanel x:Name="FixedMovementHelpPanel" Spacing="4">
                        <TextBlock
                            x:Name="FixedMovementHelpText"
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="펫을 직접 드래그한 위치에 그대로 둡니다." />
                    </StackPanel>
                    <StackPanel x:Name="MovementSensePanel" Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="이동 감각" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="MovementSpeedNumberBox"
                                Header="이동 속도 (px/s)"
                                Maximum="1000"
                                Minimum="20"
                                SmallChange="10"
                                ValueChanged="MovementControls_Changed" />
                            <NumberBox
                                x:Name="MovementStopRadiusNumberBox"
                                Grid.Column="1"
                                Header="정지 반경 (px)"
                                Maximum="128"
                                Minimum="0"
                                SmallChange="4"
                                ValueChanged="MovementControls_Changed" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="MovementBoundaryPanel" Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="이동 범위" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="MovementBoundaryModeComboBox"
                                Header="이동 범위"
                                SelectionChanged="MovementControls_Changed">
                                <ComboBoxItem Content="모든 화면" Tag="AllDisplays" />
                                <ComboBoxItem Content="선택 모니터" Tag="SelectedDisplay" />
                                <ComboBoxItem Content="사용자 지정" Tag="CustomArea" />
                            </ComboBox>
                            <ComboBox
                                x:Name="MovementScreenComboBox"
                                Grid.Column="1"
                                DisplayMemberPath="DisplayName"
                                Header="대상 모니터"
                                SelectedValuePath="Identifier"
                                SelectionChanged="MovementControls_Changed" />
                        </Grid>
                        <Grid x:Name="MovementCustomAreaPanel" ColumnSpacing="12" RowSpacing="8" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <NumberBox x:Name="MovementAreaXNumberBox" Header="왼쪽 여백 (%)" Minimum="0" Maximum="99" SmallChange="5" ValueChanged="MovementControls_Changed" />
                            <NumberBox x:Name="MovementAreaYNumberBox" Grid.Column="1" Header="아래쪽 여백 (%)" Minimum="0" Maximum="99" SmallChange="5" ValueChanged="MovementControls_Changed" />
                            <NumberBox x:Name="MovementAreaWidthNumberBox" Grid.Row="1" Header="영역 너비 (%)" Minimum="1" Maximum="100" SmallChange="5" ValueChanged="MovementControls_Changed" />
                            <NumberBox x:Name="MovementAreaHeightNumberBox" Grid.Row="1" Grid.Column="1" Header="영역 높이 (%)" Minimum="1" Maximum="100" SmallChange="5" ValueChanged="MovementControls_Changed" />
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="CursorFollowingOptionsPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="마우스 따라가기" />
                        <NumberBox
                            x:Name="CursorDistanceNumberBox"
                            Header="마우스와 거리 (px)"
                            Maximum="512"
                            Minimum="0"
                            SmallChange="8"
                            ValueChanged="MovementControls_Changed" />
                        <local:MovementAnimationEditor x:Name="CursorFollowingAnimationEditor" SettingsChanged="MovementAnimationEditor_SettingsChanged" />
                        <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="마우스 포인터와 지정한 거리를 유지하며 화면 안에서 따라갑니다." />
                    </StackPanel>
                    <StackPanel x:Name="FreeRoamingOptionsPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock x:Name="FreeRoamingSectionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" Text="자유 이동" />
                        <NumberBox
                            x:Name="FreeRoamingDwellNumberBox"
                            Header="머무는 시간 (초)"
                            Maximum="300"
                            Minimum="0.5"
                            SmallChange="0.5"
                            ValueChanged="MovementControls_Changed" />
                        <ToggleSwitch
                            x:Name="RandomizesDwellToggle"
                            Header="머무는 시간을 범위 안에서 무작위로 선택"
                            Toggled="MovementControls_Changed" />
                        <NumberBox
                            x:Name="FreeRoamingDwellMinimumNumberBox"
                            Header="최소 머무는 시간 (초)"
                            Maximum="300"
                            Minimum="0.5"
                            SmallChange="0.5"
                            ValueChanged="MovementControls_Changed" />
                        <ToggleSwitch
                            x:Name="PrefersFrontmostWindowToggle"
                            Header="현재 사용 중인 앱의 창 근처를 우선"
                            Toggled="MovementControls_Changed" />
                        <local:MovementAnimationEditor x:Name="FreeRoamingAnimationEditor" SettingsChanged="MovementAnimationEditor_SettingsChanged" />
                        <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="창 정보를 얻을 수 없거나 전체 화면이면 현재 화면 안에서 안전한 위치를 선택합니다." />
                    </StackPanel>
                    <StackPanel x:Name="CursorAvoidingOptionsPanel" Spacing="10" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="마우스 도망가기" />
                        <ComboBox
                            x:Name="AvoidingIdleBehaviorComboBox"
                            Header="평상시 행동"
                            SelectionChanged="MovementControls_Changed">
                            <ComboBoxItem Content="가만히 있기" Tag="Stationary" />
                            <ComboBoxItem Content="자유 이동" Tag="FreeRoaming" />
                        </ComboBox>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="AvoidingDetectionNumberBox"
                                Header="마우스 감지 거리 (px)"
                                Maximum="1024"
                                Minimum="32"
                                SmallChange="8"
                                ValueChanged="MovementControls_Changed" />
                            <NumberBox
                                x:Name="AvoidingSpeedNumberBox"
                                Grid.Column="1"
                                Header="도망가는 속도 (px/s)"
                                Maximum="1000"
                                Minimum="20"
                                SmallChange="10"
                                ValueChanged="MovementControls_Changed" />
                        </Grid>
                        <local:MovementAnimationEditor x:Name="CursorAvoidingAnimationEditor" SettingsChanged="MovementAnimationEditor_SettingsChanged" />
                        <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="안전한 거리까지 멀어지면 선택한 평상시 행동으로 돌아갑니다." />
                    </StackPanel>
                    <StackPanel x:Name="MovementInteractionPanel" Spacing="8">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="상호작용" />
                        <ComboBox
                            x:Name="PettingMotionComboBox"
                            DisplayMemberPath="DisplayName"
                            Header="쓰다듬기 행동"
                            SelectedValuePath="Id"
                            SelectionChanged="MovementControls_Changed" />
                        <TextBlock x:Name="PettingDescriptionText" Style="{StaticResource SettingsCaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="PetLibraryCard"
                Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="현재 펫" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="지금 데스크톱에서 함께하고 있는 펫과 사용할 수 있는 애니메이션입니다." />
                    </StackPanel>
                    <ComboBox
                        x:Name="CurrentPetComboBox"
                        DisplayMemberPath="DisplayName"
                        Header="현재 펫"
                        SelectedValuePath="InstallationId"
                        Visibility="Collapsed"
                        SelectionChanged="CurrentPetComboBox_SelectionChanged" />
                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="160"
                                Height="160"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="12">
                                <Grid>
                                    <FontIcon
                                        x:Name="CurrentPetPreviewPlaceholder"
                                        FontSize="52"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xEB55;" />
                                    <Image
                                        x:Name="CurrentPetPreviewImage"
                                        Margin="8"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock
                                    x:Name="CurrentPetNameText"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="펫을 불러오는 중입니다." />
                                <TextBlock x:Name="CurrentPetAuthorVersionText" Style="{StaticResource SettingsCaptionStyle}" />
                                <TextBlock x:Name="CurrentPetDescriptionText" TextWrapping="Wrap" />
                                <TextBlock x:Name="CurrentPetMotionText" Style="{StaticResource SettingsCaptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button
                        x:Name="EditPetDetailsButton"
                        HorizontalAlignment="Left"
                        Click="EditPetDetailsButton_Click"
                        Content="펫 정보 수정…" />
                    <TextBlock
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="내장 펫이나 여러 펫이 같은 이미지를 공유하는 경우에도 선택한 펫만 안전하게 분리해 수정합니다."
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsDividerStyle}" />

                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="애니메이션" />
                            <TextBlock
                                x:Name="AnimationEditingCaptionText"
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="현재 펫에서 사용할 수 있는 애니메이션입니다." />
                        </StackPanel>
                        <ListView
                            x:Name="PetAnimationsList"
                            MaxHeight="260"
                            HorizontalContentAlignment="Stretch"
                            SelectionChanged="PetAnimationsList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,7" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding DisplayName}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{Binding DefaultBadge}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                x:Name="AddPetAnimationButton"
                                Click="AddPetAnimationButton_Click"
                                Content="애니메이션 추가…"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                            <Button
                                x:Name="EditPetAnimationButton"
                                Grid.Column="1"
                                Click="EditPetAnimationButton_Click"
                                Content="수정…"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                            <Button
                                x:Name="DuplicatePetAnimationButton"
                                Grid.Row="1"
                                Click="DuplicatePetAnimationButton_Click"
                                Content="애니메이션 복제…"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                            <Button
                                x:Name="DeletePetAnimationButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Click="DeletePetAnimationButton_Click"
                                Content="삭제"
                                Foreground="{ThemeResource MongleDangerForegroundBrush}"
                                Style="{StaticResource SettingsActionButtonStyle}" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="10" Visibility="Collapsed">
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="웹에서 펫 가져오기" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="MonglePet 웹에서 원하는 펫을 찾아보세요."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="펫 상세 화면에서 앱으로 가져오거나 주소를 복사할 수 있습니다."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="BrowseWebPetsButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            AutomationProperties.Name="MonglePet 웹에서 펫 보러가기"
                            Click="BrowseWebPetsButton_Click"
                            Content="펫 보러가기"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Border Style="{StaticResource SettingsDividerStyle}" />
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="주소로 직접 가져오기" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="MonglePet 펫 상세 주소가 있다면 아래에 붙여 넣으세요."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox
                            x:Name="RemotePetUrlTextBox"
                            AutomationProperties.Name="MonglePet 펫 상세 주소"
                            KeyDown="RemotePetUrlTextBox_KeyDown"
                            PlaceholderText="펫 상세 주소를 붙여 넣으세요"
                            TextChanged="RemotePetUrlTextBox_TextChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button
                                x:Name="ImportRemotePetButton"
                                AutomationProperties.Name="주소에서 펫 가져오기"
                                Click="ImportRemotePetButton_Click"
                                Content="주소에서 가져오기" />
                            <ProgressRing
                                x:Name="RemotePetImportProgressRing"
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="웹 펫을 가져오는 중"
                                IsActive="False"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="RemotePetImportStatusText"
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="펫 정보를 확인하고 있습니다."
                                Visibility="Collapsed" />
                        </StackPanel>
                        <InfoBar
                            x:Name="RemotePetImportInfoBar"
                            AutomationProperties.Name="웹 펫 가져오기 오류"
                            IsClosable="True"
                            IsOpen="False"
                            Severity="Error" />
                    </StackPanel>

                    <StackPanel Spacing="8" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Windows의 패키지 가져오기" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="PC에 저장된 .monglepet 파일을 선택해 설치 내용을 확인합니다."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ImportPackageButton"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="MonglePet 패키지 파일 선택"
                            Click="ImportPackageButton_Click"
                            Content="패키지 파일 선택…" />
                    </StackPanel>

                    <StackPanel Spacing="8" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="현재 펫 내보내기" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="선택한 펫과 선택적인 권장 설정을 .monglepet 파일로 저장합니다."
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ExportPackageButton"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="현재 펫을 MonglePet 패키지로 저장"
                            Click="ExportPackageButton_Click"
                            Content="패키지 파일로 저장…" />
                        <StackPanel
                            x:Name="BuiltInPetExportLockPanel"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="Collapsed">
                            <FontIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Glyph="&#xE72E;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="내장 몽글이는 패키지 파일로 내보낼 수 없습니다."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="펫 관리" />
                        <TextBlock
                            x:Name="PetManagementCaptionText"
                            Style="{StaticResource SettingsCaptionStyle}"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button
                                x:Name="CreatePetButton"
                                Click="CreatePetButton_Click"
                                Content="새 펫 만들기…"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="CreateEditablePetCopyButton"
                                Grid.Row="1"
                                Click="CreateEditablePetCopyButton_Click"
                                Content="펫 사본 새로 만들기…"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Visibility="Collapsed" />
                            <Button
                                x:Name="DeleteCurrentPetButton"
                                Grid.Row="1"
                                Grid.Column="1"
                                Click="DeleteCurrentPetButton_Click"
                                Content="펫 삭제…"
                                Foreground="{ThemeResource MongleDangerForegroundBrush}"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                Visibility="Collapsed" />
                        </Grid>
                        <Expander Header="다른 설치된 펫 선택" Visibility="Collapsed">
                            <ListView
                                x:Name="InstalledPetsList"
                                IsItemClickEnabled="False"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding DisplayName}" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                Click="ActivatePetButton_Click"
                                                Content="사용"
                                                IsEnabled="{Binding CanActivate}"
                                                Tag="{Binding InstallationId}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Expander>
                        <Button
                            x:Name="InstallSampleButton"
                            HorizontalAlignment="Left"
                            Click="InstallSampleButton_Click"
                            Content="기본 몽글이 복원"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <InfoBar
                        x:Name="LibraryInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <Border
                x:Name="BehaviorSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <Border
                        x:Name="RoutineEditorCard"
                        Style="{StaticResource SettingsSubcardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="행동 루틴 편집" />
                                    <TextBlock
                                        Style="{StaticResource SettingsCaptionStyle}"
                                        Text="각 단계의 반복 횟수로 한 순환의 길이를 조절합니다. 평상시 하나 선택 행동은 펫이 깨어 있는 동안 계속 반복됩니다."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="AddSequenceButton"
                                    Grid.Column="1"
                                    Click="AddSequenceButton_Click"
                                    Content="새 행동 루틴 만들기"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="RoutineEditorComboBox"
                                    DisplayMemberPath="DisplayName"
                                    Header="현재 행동 루틴"
                                    SelectedValuePath="Id"
                                    SelectionChanged="RoutineEditorComboBox_SelectionChanged" />
                                <Button
                                    x:Name="RenameSequenceButton"
                                    Grid.Column="1"
                                    Margin="0,24,0,0"
                                    Click="RenameSequenceButton_Click"
                                    Content="이름 변경" />
                                <Button
                                    x:Name="DeleteSequenceButton"
                                    Grid.Column="2"
                                    Margin="0,24,0,0"
                                    Click="DeleteSequenceButton_Click"
                                    Content="선택 삭제"
                                    Foreground="{ThemeResource MongleDangerForegroundBrush}" />
                            </Grid>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="애니메이션 단계" />
                            <ListView
                                x:Name="BehaviorStepsList"
                                HorizontalContentAlignment="Stretch"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="10">
                                            <Grid ColumnSpacing="12" RowSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border
                                                    Width="32"
                                                    Height="32"
                                                    VerticalAlignment="Center"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    CornerRadius="16">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"
                                                        Text="{Binding DisplayIndex}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="5">
                                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="애니메이션" />
                                                    <Button
                                                        AutomationProperties.Name="단계 애니메이션 선택"
                                                        Click="ChooseStepMotionButton_Click"
                                                        Content="{Binding MotionDisplayName}"
                                                        HorizontalContentAlignment="Left"
                                                        HorizontalAlignment="Stretch"
                                                        MinWidth="220"
                                                        Tag="{Binding Index}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    MaxWidth="180"
                                                    HorizontalAlignment="Left"
                                                    Spacing="5">
                                                    <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="반복 횟수" />
                                                    <NumberBox
                                                        Maximum="100000"
                                                        Minimum="1"
                                                        SmallChange="1"
                                                        SpinButtonPlacementMode="Compact"
                                                        Tag="{Binding Index}"
                                                        Value="{Binding RepeatCount, Mode=OneWay}"
                                                        ValueChanged="StepRepeatCountNumberBox_ValueChanged" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Bottom"
                                                    Orientation="Horizontal"
                                                    Spacing="6">
                                                    <Button
                                                        Width="36"
                                                        Click="MoveStepUpButton_Click"
                                                        Content="↑"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        Tag="{Binding Index}"
                                                        ToolTipService.ToolTip="위로 이동" />
                                                    <Button
                                                        Width="36"
                                                        Click="MoveStepDownButton_Click"
                                                        Content="↓"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Tag="{Binding Index}"
                                                        ToolTipService.ToolTip="아래로 이동" />
                                                    <Button
                                                        Click="RemoveStepButton_Click"
                                                        Content="삭제"
                                                        Foreground="{ThemeResource MongleDangerForegroundBrush}"
                                                        IsEnabled="{Binding CanDelete}"
                                                        Tag="{Binding Index}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button
                                x:Name="AddStepButton"
                                Click="AddStepButton_Click"
                                Content="애니메이션 단계 추가"
                                Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="현재 펫이 가진 애니메이션을 순서대로 조합합니다. 루틴 이름은 위의 이름 변경 버튼으로 바꿀 수 있습니다." />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="AutomaticRulesCard"
                        Style="{StaticResource SettingsSubcardStyle}"
                        Visibility="Collapsed">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="규칙 우선순위" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="위에 있는 항목부터 적용합니다. 규칙이 표시 및 이동보다 앞에 있으면 펫이 현재 위치에서 멈추고 해당 규칙의 행동을 표시합니다."
                                TextWrapping="Wrap" />
                            <ListView
                                x:Name="RulePriorityOrderList"
                                MaxHeight="150"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding DisplayName}" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SettingsCaptionStyle}"
                                                Text="{Binding Rank}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="MoveRulePriorityUpButton_Click" Content="위로" />
                                <Button Click="MoveRulePriorityDownButton_Click" Content="아래로" />
                            </StackPanel>
                            <Border Style="{StaticResource SettingsDividerStyle}" />
                            <Border Style="{StaticResource SettingsSubcardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="입력 없음 규칙" />
                                    <ToggleSwitch
                                        x:Name="IdleRuleEnabledToggle"
                                        Header="입력 없음 규칙 사용"
                                        IsOn="False"
                                        Toggled="IdleRuleEnabledToggle_Toggled" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            x:Name="IdleRuleSecondsNumberBox"
                                            Header="입력 없음 시간 (초)"
                                            Maximum="86400"
                                            Minimum="1"
                                            SmallChange="1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="60" />
                                        <ComboBox
                                            x:Name="IdleRuleTargetSequenceComboBox"
                                            Grid.Column="1"
                                            DisplayMemberPath="DisplayName"
                                            Header="실행할 행동"
                                            SelectedValuePath="Id" />
                                    </Grid>
                                    <Button
                                        x:Name="SaveIdleRuleSettingsButton"
                                        HorizontalAlignment="Left"
                                        Click="SaveIdleRuleSettingsButton_Click"
                                        Content="입력 없음 규칙 변경" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingsDividerStyle}" />
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="등록된 앱 사용 규칙" />
                            <ListView
                                x:Name="AutomaticRulesList"
                                SelectionChanged="AutomaticRulesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Summary}" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="NewApplicationRuleButton"
                                    Click="NewApplicationRuleButton_Click"
                                    Content="앱 규칙 추가"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="NewIdleRuleButton" Click="NewIdleRuleButton_Click" Content="입력 없음 규칙 추가" Visibility="Collapsed" />
                                <Button x:Name="DeleteRuleButton" Click="DeleteRuleButton_Click" Content="선택 규칙 삭제" Foreground="{ThemeResource MongleDangerForegroundBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RuleEnabledToggle" Header="규칙 사용" IsOn="True" />
                            <NumberBox
                                x:Name="RulePriorityNumberBox"
                                Header="우선순위 (큰 숫자 먼저)"
                                Maximum="2147483647"
                                Minimum="-2147483648"
                                SmallChange="1"
                                Visibility="Collapsed"
                                SpinButtonPlacementMode="Compact" />
                            <ComboBox
                                x:Name="RuleConditionTypeComboBox"
                                Header="조건 종류"
                                SelectionChanged="RuleConditionTypeComboBox_SelectionChanged"
                                Visibility="Collapsed">
                                <ComboBoxItem Content="전면 앱" Tag="Application" />
                                <ComboBoxItem Content="입력 없음" Tag="Idle" />
                            </ComboBox>
                            <StackPanel x:Name="ApplicationRuleEditorGrid" Spacing="8">
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="선택한 대상 앱" />
                                        <TextBlock
                                            x:Name="RuleApplicationSelectionText"
                                            Text="선택되지 않음"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBox
                                    x:Name="RuleApplicationIdTextBox"
                                    Header="Windows 앱 식별자"
                                    PlaceholderText="pfn:... 또는 exe:notepad.exe"
                                    TextChanged="RuleApplicationIdTextBox_TextChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="ChooseApplicationButton"
                                        Click="ChooseApplicationButton_Click"
                                        Content="실행 중 앱 선택…" />
                                    <Button
                                        x:Name="ChooseExecutableButton"
                                        Click="ChooseExecutableButton_Click"
                                        Content="실행 파일 선택…" />
                                    <Button
                                        x:Name="UseCurrentApplicationButton"
                                        Click="UseCurrentApplicationButton_Click"
                                        Content="현재 전면 앱 사용" />
                                </StackPanel>
                            </StackPanel>
                            <NumberBox
                                x:Name="RuleIdleMinutesNumberBox"
                                Header="입력 없음 시간 (초)"
                                Maximum="86400"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="1"
                                Visibility="Collapsed" />
                            <ComboBox
                                x:Name="RuleTargetSequenceComboBox"
                                DisplayMemberPath="DisplayName"
                                Header="실행할 루틴"
                                SelectedValuePath="Id" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddRuleButton" Click="AddRuleButton_Click" Content="앱 규칙 추가" />
                                <Button
                                    x:Name="SaveRuleButton"
                                    Click="SaveRuleButton_Click"
                                    Content="선택 규칙 저장" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="입력 없음 감지는 1초 주기라 실제 전환에 최대 약 1초가 걸릴 수 있습니다." />
                        </StackPanel>
                    </Border>
                    <InfoBar
                        x:Name="BehaviorSettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </NavigationView>
</Page>
