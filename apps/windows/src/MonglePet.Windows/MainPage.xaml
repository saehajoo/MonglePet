<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MonglePet.Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MonglePet.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource LayerFillColorDefaultBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="SettingsHeroStyle" TargetType="Border">
            <Setter Property="Padding" Value="4,8,4,10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SettingsDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <DataTemplate x:Key="ApplicationPickerItemTemplate">
            <Grid Padding="4,8" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <FontIcon FontSize="22" Glyph="&#xE8A5;" />
                    <Image Source="{Binding Icon}" Stretch="Uniform" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding DisplayName}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding Identifier}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <NavigationView
        x:Name="SettingsNavigationView"
        AlwaysShowHeader="False"
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        CompactPaneLength="52"
        IsBackButtonVisible="Collapsed"
        IsPaneOpen="True"
        IsSettingsVisible="False"
        OpenPaneLength="220"
        PaneDisplayMode="Left"
        SelectionChanged="SettingsNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="데스크톱" />
            <NavigationViewItem Content="활성 펫" IsSelected="True" Tag="activePets">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="일반" Tag="general">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="선택한 펫" />
            <NavigationViewItem Content="표시 및 이동" Tag="movement">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Map" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="행동 루틴" Tag="routines">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="말풍선" Tag="speech">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Comment" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="자동 규칙" Tag="automaticRules">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="보관함" />
            <NavigationViewItem Content="펫 보관함" Tag="pet">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Folder" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItemHeader Content="지원" />
            <NavigationViewItem Content="문제 해결" Tag="troubleshooting">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <ScrollViewer
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Padding="28,12,28,48">
                <StackPanel
                    MaxWidth="920"
                    HorizontalAlignment="Stretch"
                    Spacing="20">

            <Border Style="{StaticResource SettingsHeroStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="48"
                        Height="48"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="24">
                        <Image Margin="9" Source="Assets/AppIcon.ico" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock x:Name="SettingsSectionTitle" Style="{StaticResource TitleTextBlockStyle}" Text="펫" />
                        <TextBlock
                            x:Name="SettingsSectionDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="현재 펫을 선택하고 .monglepet 패키지를 가져오거나 내보냅니다."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                x:Name="SafeStartInfoBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Warning"
                Title="안전 시작">
                <InfoBar.ActionButton>
                    <Button Click="ResumeAllSafeStartButton_Click" Content="모두 복원" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border
                x:Name="TroubleshootingCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="안전 모드" />
                    <TextBlock
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="이전 실행에서 펫 복원이 중단되었을 때만 안전 시작이 활성화됩니다. 문제가 된 마지막 펫을 제외하거나 모든 펫을 다시 복원할 수 있습니다."
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="ResumeAllSafeStartButton_Click" Content="모두 복원" />
                        <Button
                            x:Name="ResumeWithoutLastSafeStartButton"
                            Click="ResumeWithoutLastSafeStartButton_Click"
                            Content="마지막 복원 펫 제외"
                            Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="ActivePetsCard"
                Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="활성 펫" />
                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="목록 위쪽의 펫이 화면에서도 앞에 표시됩니다." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            Click="AddActivePetButton_Click"
                            Content="펫 추가"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="WakeAllPetsButton_Click" Content="모두 깨우기" />
                        <Button Click="TuckAwayAllPetsButton_Click" Content="모두 재우기" />
                        <Button x:Name="PauseAllPetsButton" Click="PauseAllPetsButton_Click" Content="모든 펫 일시정지/재개" />
                    </StackPanel>
                    <ListView
                        x:Name="ActivePetsList"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        IsTabStop="False"
                        IsItemClickEnabled="True"
                        ItemClick="ActivePetsList_ItemClick"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border Padding="16" Style="{StaticResource SettingsSubcardStyle}">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="84"
                                            Height="84"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="12">
                                            <Grid>
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="28"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                    Text="🐾" />
                                                <Image
                                                    Margin="6"
                                                    Source="{Binding Preview}"
                                                    Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="5">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                                    Text="{Binding DisplayName}" />
                                                <Border
                                                    Padding="7,2"
                                                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                                    CornerRadius="9"
                                                    Visibility="{Binding SelectionVisibility}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        Text="설정 중" />
                                                </Border>
                                            </StackPanel>
                                            <TextBox
                                                Header="구분 이름 (선택)"
                                                LostFocus="ActivePetNicknameTextBox_LostFocus"
                                                Tag="{Binding InstanceId}"
                                                Text="{Binding Nickname, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Click="MoveActivePetUpButton_Click" Content="↑" Tag="{Binding InstanceId}" ToolTipService.ToolTip="앞으로" />
                                            <Button Click="MoveActivePetDownButton_Click" Content="↓" Tag="{Binding InstanceId}" ToolTipService.ToolTip="뒤로" />
                                            <Button Click="ToggleActivePetButton_Click" Content="{Binding PresentationCommand}" Tag="{Binding InstanceId}" />
                                            <Button Click="RemoveActivePetButton_Click" Content="제거" Tag="{Binding InstanceId}" />
                                        </StackPanel>
                                    </Grid>
                                    </Border>
                                    <Border
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding SelectionVisibility}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border
                x:Name="GeneralSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="PetPresentationPanel" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="표시 상태" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="선택한 펫을 깨우거나 잠시 재울 수 있습니다. 재워도 시스템 트레이나 활성 펫 화면에서 다시 깨울 수 있습니다." />
                        </StackPanel>
                        <Button
                            x:Name="VisibilityButton"
                            Click="VisibilityButton_Click"
                            Content="펫 재우기"
                            HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                x:Name="OverlaySettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <StackPanel x:Name="OverlayDisplayPanel" Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="화면 표시" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="펫의 크기와 선명도, 화면 위에서 마우스와 겹칠 때의 표시 방법을 정합니다." />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ClickThroughToggle"
                            Header="클릭 통과"
                            IsOn="True"
                            Toggled="ClickThroughToggle_Toggled" />
                        <ToggleSwitch
                            x:Name="PointerOverlapFadeToggle"
                            Header="마우스가 펫과 겹치면 더 투명하게"
                            Toggled="PointerOverlapFadeToggle_Toggled" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="펫 크기" />
                            <Slider
                                x:Name="OverlayWidthSlider"
                                Grid.Column="1"
                                Maximum="384"
                                Minimum="19.2"
                                SmallChange="9.6"
                                StepFrequency="9.6"
                                ValueChanged="DisplaySlider_ValueChanged" />
                            <TextBlock
                                x:Name="OverlayWidthValueText"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="기본 투명도" />
                            <Slider
                                x:Name="OverlayOpacitySlider"
                                Grid.Row="1"
                                Grid.Column="1"
                                Maximum="1"
                                Minimum="0.1"
                                SmallChange="0.05"
                                StepFrequency="0.05"
                                ValueChanged="DisplaySlider_ValueChanged" />
                            <TextBlock
                                x:Name="OverlayOpacityValueText"
                                Grid.Row="1"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="겹침 투명도" />
                            <Slider
                                x:Name="PointerOverlapOpacitySlider"
                                Grid.Row="2"
                                Grid.Column="1"
                                Maximum="1"
                                Minimum="0.05"
                                SmallChange="0.05"
                                StepFrequency="0.05"
                                ValueChanged="DisplaySlider_ValueChanged" />
                            <TextBlock
                                x:Name="PointerOverlapOpacityValueText"
                                Grid.Row="2"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SettingsCaptionStyle}" Text="빠른 크기" />
                            <Button Click="OverlaySizePresetButton_Click" Content="10%" Tag="10" />
                            <Button Click="OverlaySizePresetButton_Click" Content="25%" Tag="25" />
                            <Button Click="OverlaySizePresetButton_Click" Content="50%" Tag="50" />
                            <Button Click="OverlaySizePresetButton_Click" Content="100%" Tag="100" />
                            <Button Click="OverlaySizePresetButton_Click" Content="150%" Tag="150" />
                            <Button Click="OverlaySizePresetButton_Click" Content="200%" Tag="200" />
                        </StackPanel>
                        <InfoBar
                            x:Name="TinyPetInfoBar"
                            IsClosable="False"
                            IsOpen="False"
                            Message="25% 미만에서는 펫을 찾거나 직접 드래그하기 어려울 수 있습니다."
                            Severity="Informational"
                            Title="아주 작은 펫 크기">
                            <InfoBar.ActionButton>
                                <Button Click="BringPetToCurrentScreenButton_Click" Content="현재 화면으로 가져오기" />
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="클릭 통과가 켜진 동안 마우스가 펫의 보이는 부분에 닿았을 때만 겹침 투명도를 적용합니다." />
                        <ToggleSwitch
                            x:Name="PixelArtToggle"
                            Header="픽셀 아트 선명하게"
                            Toggled="PixelArtToggle_Toggled" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="픽셀 아트는 nearest 보간으로 또렷하게 표시합니다. 일반 일러스트에서는 끄는 편이 자연스럽습니다."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border x:Name="DisplayApplicationDivider" Style="{StaticResource SettingsDividerStyle}" />
                    <StackPanel x:Name="ApplicationSettingsPanel" Spacing="10">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="앱 실행" />
                        <ToggleSwitch
                            x:Name="LoginLaunchToggle"
                            Header="로그인 시 MonglePet 자동 실행"
                            Toggled="LoginLaunchToggle_Toggled" />
                        <TextBlock
                            x:Name="LoginLaunchStatusText"
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="Windows 시작 앱 상태를 확인하는 중입니다." />
                        <Button
                            x:Name="OpenStartupAppsSettingsButton"
                            Click="OpenStartupAppsSettingsButton_Click"
                            Content="Windows 시작 앱 설정 열기"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Border x:Name="ApplicationInfoDivider" Style="{StaticResource SettingsDividerStyle}" />
                    <StackPanel x:Name="AppInformationPanel" Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="앱 정보" />
                            <TextBlock x:Name="AppVersionText" Text="MonglePet 버전을 확인하는 중입니다." />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="Windows 11에서 동작하는 네이티브 데스크톱 펫입니다. 설정과 활동 정보는 이 기기 안에 저장됩니다." />
                        </StackPanel>
                    </StackPanel>
                    <InfoBar
                        x:Name="DisplaySettingsInfoBar"
                        IsClosable="True"
                        IsOpen="False" />
                </StackPanel>
            </Border>

            <Border
                x:Name="SpeechSettingsCard"
                Style="{StaticResource SettingsCardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="말풍선" />
                        <TextBlock
                            Style="{StaticResource SettingsCaptionStyle}"
                            Text="현재 펫이 행동을 바꾸거나 일정 시간이 지났을 때 보여 줄 말을 정합니다." />
                    </StackPanel>
                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="설정 대상 펫" />
                            <TextBlock
                                x:Name="SpeechTargetPetText"
                                Grid.Column="1"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </Grid>
                    </Border>
                    <ToggleSwitch
                        x:Name="SpeechEnabledToggle"
                        Header="말풍선 사용"
                        Toggled="SpeechSettings_Changed" />
                    <ComboBox
                        x:Name="SpeechBehaviorChangePolicyComboBox"
                        Header="행동이 바뀌었는데 연결된 대사가 없을 때"
                        SelectionChanged="SpeechSettings_Changed">
                        <ComboBoxItem Content="현재 말풍선 닫기" Tag="Dismiss" />
                        <ComboBoxItem Content="다음 대사까지 유지" Tag="Keep" />
                    </ComboBox>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="주기적으로 말하기" />
                            <ToggleSwitch
                                x:Name="SpeechPeriodicEnabledToggle"
                                Header="주기 대사 사용"
                                Toggled="SpeechSettings_Changed" />
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="SpeechPeriodicIntervalNumberBox"
                                    Header="표시 간격 (초)"
                                    Maximum="3600"
                                    Minimum="5"
                                    SmallChange="5"
                                    SpinButtonPlacementMode="Inline"
                                    ValueChanged="SpeechSettings_Changed" />
                                <ComboBox
                                    x:Name="SpeechPeriodicOrderComboBox"
                                    Grid.Column="1"
                                    Header="재생 순서"
                                    SelectionChanged="SpeechSettings_Changed">
                                    <ComboBoxItem Content="무작위" Tag="Random" />
                                    <ComboBoxItem Content="순차" Tag="Sequential" />
                                </ComboBox>
                            </Grid>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="시간 지정 대사는 말풍선이 숨은 뒤부터 기다리고, 유지 대사는 표시된 시점부터 기다린 뒤 다음 대사로 교체합니다." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="행동 대사" />
                            <ListView
                                x:Name="BehaviorSpeechPhrasesList"
                                SelectionChanged="BehaviorSpeechPhrasesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddBehaviorSpeechPhraseButton" Click="AddBehaviorSpeechPhraseButton_Click" Content="행동 대사 추가…" />
                                <Button x:Name="EditBehaviorSpeechPhraseButton" Click="EditBehaviorSpeechPhraseButton_Click" Content="수정…" />
                                <Button x:Name="DeleteBehaviorSpeechPhraseButton" Click="DeleteBehaviorSpeechPhraseButton_Click" Content="삭제" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="행동 루틴이 시작될 때 우선해서 보여 줄 대사입니다." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsSubcardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="주기 대사" />
                            <ListView
                                x:Name="PeriodicSpeechPhrasesList"
                                SelectionChanged="PeriodicSpeechPhrasesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="0,6" Spacing="2">
                                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Text}" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="8">
