<UserControl
    x:Class="MonglePet.Windows.PetAnimationEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="0,0,6,0">
            <InfoBar x:Name="EditorInfoBar" IsOpen="False" IsClosable="True" />

            <Border x:Name="PetInformationCard" Style="{StaticResource SettingsSubcardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="펫 정보" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="PetNameTextBox" Header="펫 이름" PlaceholderText="새 펫" />
                        <TextBox x:Name="AuthorTextBox" Grid.Column="1" Header="제작자" PlaceholderText="MonglePet 사용자" />
                        <TextBox x:Name="VersionTextBox" Grid.Row="1" Header="버전" PlaceholderText="자유 문자열" />
                        <TextBox
                            x:Name="DescriptionTextBox"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            AcceptsReturn="True"
                            Header="설명"
                            MaxHeight="100"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                x:Name="BehaviorConnectionCard"
                Style="{StaticResource SettingsSubcardStyle}"
                Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="행동 연결" />
                    <TextBlock
                        x:Name="BehaviorConnectionUsageText"
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="애니메이션 저장과 함께 행동을 연결할 수 있습니다. 저장하기 전에는 행동 설정을 바꾸지 않습니다."
                        TextWrapping="Wrap" />
                    <ComboBox
                        x:Name="BehaviorConnectionModeComboBox"
                        Header="저장 후 연결"
                        SelectionChanged="BehaviorConnectionModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="연결 안 함" Tag="none" />
                        <ComboBoxItem Content="새 행동 만들기" Tag="new" />
                        <ComboBoxItem Content="기존 행동에 추가" Tag="existing" />
                    </ComboBox>
                    <TextBox
                        x:Name="NewBehaviorNameTextBox"
                        Header="새 행동 이름"
                        PlaceholderText="비우면 애니메이션 이름을 사용합니다."
                        Visibility="Collapsed" />
                    <ComboBox
                        x:Name="ExistingBehaviorComboBox"
                        DisplayMemberPath="DisplayName"
                        Header="추가할 행동"
                        SelectedValuePath="Id"
                        Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSubcardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="애니메이션 설정" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox
                            x:Name="AnimationNameTextBox"
                            Width="360"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Header="이름"
                            PlaceholderText="기본" />
                        <ToggleSwitch
                            x:Name="LoopsToggle"
                            Grid.Column="1"
                            Margin="0,24,0,0"
                            Header="재생"
                            IsOn="True"
                            OffContent="한 번 재생"
                            OnContent="반복 재생" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                x:Name="NewFrameDurationNumberBox"
                                Header="새 프레임 간격 (ms)"
                                Maximum="60000"
                                Minimum="16"
                                SmallChange="10"
                                SpinButtonPlacementMode="Compact"
                                Value="450" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8"
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="앞으로 추가할 프레임의 기본값입니다. 기존 프레임 간격은 바꾸지 않습니다." />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSubcardStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="애니메이션 프레임" />
                            <TextBlock
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="프레임을 선택하면 미리보기·위치·재생 간격을 개별 편집할 수 있습니다." />
                        </StackPanel>
                        <Button x:Name="FrameImportButton" Grid.Column="1" Content="프레임 선택">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Click="ChooseCurrentPetFramesButton_Click" Text="현재 펫 프레임에서 추가…" />
                                    <MenuFlyoutItem Click="ChooseFramesButton_Click" Text="개별 PNG 추가…" />
                                    <MenuFlyoutItem Click="ChooseSpriteSheetButton_Click" Text="스프라이트 시트에서 추가…" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <Grid x:Name="EmptyFrameState" MinHeight="210">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontSize="34" Glyph="&#xEB9F;" Opacity="0.65" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="추가한 프레임이 없습니다" />
                            <TextBlock
                                MaxWidth="420"
                                TextAlignment="Center"
                                Style="{StaticResource SettingsCaptionStyle}"
                                Text="프레임 선택 메뉴에서 개별 PNG 또는 정적 PNG·WebP 스프라이트 시트를 추가해 주세요." />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="FrameEditorGrid" Visibility="Collapsed" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="편집 미리보기" />
                            <Border
                                HorizontalAlignment="Left"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ScrollViewer
                                    Width="260"
                                    Height="220"
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Auto"
                                    VerticalScrollMode="Enabled"
                                    ZoomMode="Disabled">
                                    <Canvas
                                        x:Name="FramePlacementCanvas"
                                        Width="260"
                                        Height="220"
                                        PointerPressed="FramePlacementCanvas_PointerPressed"
                                        PointerMoved="FramePlacementCanvas_PointerMoved"
                                        PointerReleased="FramePlacementCanvas_PointerReleased"
                                        PointerCanceled="FramePlacementCanvas_PointerReleased">
                                        <Image x:Name="FrameCheckerImage" Width="260" Height="220" Stretch="Fill" />
                                        <Image x:Name="FirstFrameReferenceImage" Opacity="0.35" Stretch="Fill" Visibility="Collapsed" />
                                        <Image x:Name="SelectedFramePlacementImage" Stretch="Fill" />
                                        <Border x:Name="SelectedFramePlacementBorder" BorderBrush="#FF1877F2" BorderThickness="2" />
                                    </Canvas>
                                </ScrollViewer>
                            </Border>
                            <CheckBox
                                x:Name="CompareFirstFrameCheckBox"
                                Content="첫 프레임 반투명 비교"
                                Checked="CompareFirstFrameCheckBox_Changed"
                                Unchecked="CompareFirstFrameCheckBox_Changed" />
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="미리보기 확대" />
                                <Slider
                                    x:Name="PlacementZoomSlider"
                                    AutomationProperties.Name="프레임 미리보기 확대"
                                    Maximum="8"
                                    Minimum="1"
                                    StepFrequency="0.5"
                                    Value="1"
                                    ValueChanged="PlacementZoomSlider_ValueChanged" />
                            </StackPanel>
                            <Expander Header="선택 프레임 위치와 크기" IsExpanded="False">
                                <StackPanel Spacing="8" Padding="0,8,0,0">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="CanvasWidthNumberBox" Header="캔버스 너비" Minimum="1" Maximum="8192" ValueChanged="PlacementNumberBox_ValueChanged" />
                                        <NumberBox x:Name="CanvasHeightNumberBox" Grid.Column="1" Header="캔버스 높이" Minimum="1" Maximum="8192" ValueChanged="PlacementNumberBox_ValueChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox x:Name="PlacementXNumberBox" Header="X" Minimum="0" Maximum="8191" ValueChanged="PlacementNumberBox_ValueChanged" />
                                        <NumberBox x:Name="PlacementYNumberBox" Grid.Column="1" Header="Y" Minimum="0" Maximum="8191" ValueChanged="PlacementNumberBox_ValueChanged" />
                                        <NumberBox x:Name="PlacementWidthNumberBox" Grid.Column="2" Header="너비" Minimum="1" Maximum="8192" ValueChanged="PlacementNumberBox_ValueChanged" />
                                        <NumberBox x:Name="PlacementHeightNumberBox" Grid.Column="3" Header="높이" Minimum="1" Maximum="8192" ValueChanged="PlacementNumberBox_ValueChanged" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="프레임 순서와 간격" />
                            <ListView
                                x:Name="FramesList"
                                MinHeight="310"
                                MaxHeight="390"
                                SelectionChanged="FramesList_SelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="2,6" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="136" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38" Height="38" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding DisplayIndex}" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding SourceDetail}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <NumberBox
                                                Grid.Column="3"
                                                Header="간격 (ms)"
                                                Maximum="60000"
                                                Minimum="16"
                                                SmallChange="10"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{Binding DurationMilliseconds, Mode=TwoWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <Button Click="MoveFrameUpButton_Click" AutomationProperties.Name="위로 이동" ToolTipService.ToolTip="위로 이동"><FontIcon FontSize="12" Glyph="&#xE74A;" /></Button>
                                <Button Click="MoveFrameDownButton_Click" AutomationProperties.Name="아래로 이동" ToolTipService.ToolTip="아래로 이동"><FontIcon FontSize="12" Glyph="&#xE74B;" /></Button>
                                <Button Click="DuplicateFrameButton_Click" AutomationProperties.Name="프레임 복사" ToolTipService.ToolTip="프레임 복사"><FontIcon FontSize="12" Glyph="&#xE8C8;" /></Button>
                                <Button Click="FlipFrameHorizontalButton_Click" AutomationProperties.Name="좌우 반전" Content="좌우 반전" />
                                <Button Click="FlipFrameVerticalButton_Click" AutomationProperties.Name="상하 반전" Content="상하 반전" />
                                <Button Click="ResetFrameDirectionButton_Click" AutomationProperties.Name="방향 초기화" Content="방향 초기화" />
                                <Button Click="RemoveFrameButton_Click" AutomationProperties.Name="프레임 삭제" ToolTipService.ToolTip="프레임 삭제"><FontIcon FontSize="12" Glyph="&#xE74D;" /></Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="개별 프레임은 512×512 px 투명 PNG를 권장합니다. 파란 경계는 실제 저장되는 공통 캔버스 범위입니다."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
