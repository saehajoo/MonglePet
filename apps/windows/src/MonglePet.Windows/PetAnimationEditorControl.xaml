<UserControl
    x:Class="MonglePet.Windows.PetAnimationEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel Width="680" Spacing="16">
            <Border x:Name="PetInformationCard" Style="{StaticResource SettingsSubcardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="펫 정보" />
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="PetNameTextBox" Header="펫 이름" PlaceholderText="새 펫" />
                        <TextBox x:Name="AuthorTextBox" Grid.Column="1" Header="제작자" PlaceholderText="MonglePet 사용자" />
                        <TextBox x:Name="VersionTextBox" Grid.Row="1" Header="버전" PlaceholderText="1.0.0" />
                        <TextBox
                            x:Name="DescriptionTextBox"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            AcceptsReturn="True"
                            Header="설명"
                            MaxHeight="100"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSubcardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="애니메이션 설정" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="AnimationNameTextBox" Header="이름" PlaceholderText="기본" />
                        <NumberBox
                            x:Name="NewFrameDurationNumberBox"
                            Grid.Column="1"
                            Header="새 프레임 간격 (ms)"
                            Maximum="60000"
                            Minimum="16"
                            SmallChange="10"
                            SpinButtonPlacementMode="Compact"
                            Value="120" />
                        <ToggleSwitch
                            x:Name="LoopsToggle"
                            Grid.Column="2"
                            Margin="0,24,0,0"
                            Header="재생"
                            IsOn="True"
                            OffContent="한 번 재생"
                            OnContent="반복 재생" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SettingsSubcardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="애니메이션 프레임" />
                            <TextBlock Style="{StaticResource SettingsCaptionStyle}" Text="프레임 순서와 각 프레임의 재생 간격을 편집합니다." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ChooseFramesButton"
                                Click="ChooseFramesButton_Click"
                                Content="개별 PNG 추가…" />
                            <Button
                                x:Name="ChooseSpriteSheetButton"
                                Click="ChooseSpriteSheetButton_Click"
                                Content="스프라이트 시트에서 추가…" />
                        </StackPanel>
                    </Grid>
                    <ListView
                        x:Name="FramesList"
                        MaxHeight="260"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="610" Padding="0,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding DisplayIndex}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding SourceDetail}" />
                                    </StackPanel>
                                    <NumberBox
                                        Grid.Column="2"
                                        Header="간격 (ms)"
                                        Maximum="60000"
                                        Minimum="16"
                                        SmallChange="10"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding DurationMilliseconds, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="MoveFrameUpButton_Click" Content="위로" />
                        <Button Click="MoveFrameDownButton_Click" Content="아래로" />
                        <Button Click="RemoveFrameButton_Click" Content="선택 삭제" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource SettingsCaptionStyle}"
                        Text="개별 프레임은 512×512 px 투명 PNG를 권장합니다. 기존 프레임은 원본 atlas 영역을 유지한 채 다시 구성됩니다."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
